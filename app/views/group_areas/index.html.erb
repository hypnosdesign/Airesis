<nav class="breadcrumbs text-sm">
  <ul>
    <li class="current"><%= t('pages.groups.edit_work_areas.manage.breadcrumb') %></li>
  </ul>
</nav>
<%= render layout: "layouts/page_title", locals: {title: t('pages.groups.edit_work_areas.manage_group_areas')} do %>
  <%= link_to new_group_group_area_url(@group, manage: true), class: "btn btn-primary", data: { turbo_stream: true } do %>
    <i class="fa-solid fa-plus" aria-hidden="true"></i>
    <%= t('pages.groups.edit_work_areas.manage.new_area') %>
  <% end %>
<% end %>
<p class="mb-6 max-w-3xl text-base-content/70"><%= t('pages.groups.edit_work_areas.manage.list_title') %></p>
<div id="group_areas_container">
  <%= render partial: 'group_areas_list' %>
</div>
<div id="group_area_modal"></div>
<% content_for :left_panel do %>
  <%= render partial: 'groups/administration_panel' %>
<% end %>
