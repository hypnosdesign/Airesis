<% modal = local_assigns.fetch(:modal, false) %>
<% if modal %>
  <h2 id="group-area-dialog-title" class="mb-5 text-2xl font-extrabold"><%= t('pages.groups.edit_work_areas.form.title') %></h2>
<% end %>
<%= simple_form_for [@group, @group_area], validate: true, html: { data: (modal ? {} : { turbo: false }) } do |e| %>
  <%= e.input :name %>
  <%= e.input :description, as: :text, input_html: { class: 'elastic', rows: 5 } %>
  <% if ['new', 'create'].include? params[:action] %>
    <%= e.input :default_role_name %>
  <% end %>
  <input type="hidden" name="manage" value="<%= params[:manage] %>"/>
  <div class="mt-6 flex flex-wrap gap-3">
    <% if modal %>
      <%= button_tag t('buttons.cancel'), type: 'button', class: 'btn', data: { action: 'click->modal#close' } %>
    <% else %>
      <%= link_to t('buttons.cancel'), group_group_areas_path(@group), class: 'btn' %>
    <% end %>
    <%= e.submit t('buttons.create'), class: 'btn btn-primary', data: { disable_with: t('saving') } %>
  </div>
<% end %>
