<%= render layout: 'layouts/page_title', locals: { title: t('pages.groups.edit_work_areas.manage.area_title', area: @group_area.name) } do %><% end %>

<section class="border border-base-content/15 bg-base-100 p-5 sm:p-6" aria-labelledby="area-details-title">
  <h2 id="area-details-title" class="mb-4 text-xl font-extrabold"><%= t('pages.groups.edit_work_areas.manage.area_details') %></h2>
  <%= simple_form_for [@group, @group_area], validate: true do |e| %>
    <%= e.input :name %>
    <%= e.input :description, as: :text, input_html: { rows: 4 } %>
    <%= e.submit t('buttons.update'), class: 'btn btn-primary', data: {disable_with: t('saving')} %>
  <% end %>
</section>

<section class="mt-8" aria-labelledby="area-roles-title">
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 id="area-roles-title" class="text-2xl font-extrabold"><%= t('pages.groups.edit_work_areas.manage.manage_roles_in_area', area: @group_area.name) %></h2>
      <p class="mt-1 max-w-3xl text-sm text-base-content/70"><%= t('pages.groups.edit_work_areas.manage.roles_help') %></p>
    </div>
    <%= link_to new_group_group_area_area_role_url(@group, @group_area), data: { turbo_stream: true, disable_with: t('loading') }, class: 'btn btn-primary' do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
      <%= t('pages.groups.edit_permissions.new_role') %>
    <% end %>
  </div>
  <div id="roles_panel_container">
    <%= render partial: 'group_areas/roles_panel' %>
  </div>
</section>

<section class="mt-8" aria-labelledby="area-members-title">
  <h2 id="area-members-title" class="mb-2 text-2xl font-extrabold"><%= t('pages.groups.edit_work_areas.manage.member_roles') %></h2>
  <p class="mb-4 text-sm text-base-content/70"><%= t('pages.groups.edit_work_areas.manage.member_roles_help') %></p>
  <div id="roles_table_container">
    <%= render partial: 'group_areas/user_roles_panel' %>
  </div>
</section>

<div id="area_role_modal"></div>
