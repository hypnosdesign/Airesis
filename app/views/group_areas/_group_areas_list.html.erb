<% if @group_areas.any? %>
<ul class="grid grid-cols-1 gap-5 xl:grid-cols-2" role="list">
  <% @group_areas.each do |area| %>
    <li>
      <section class="h-full border border-base-content/15 bg-base-100 p-5" id="group<%= area.id %>">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0">
            <h2 class="text-xl font-extrabold">
              <%= link_to area.name, edit_group_group_area_url(@group, area), class: 'inline-flex min-h-11 items-center underline-offset-4 hover:underline' %>
            </h2>
            <% if area.description.present? %>
              <p class="mt-1 text-sm text-base-content/70"><%= area.description %></p>
            <% end %>
          </div>
          <% if can? :destroy, area %>
            <%= link_to [@group, area],
                        class: 'btn btn-ghost min-h-11 text-error',
                        data: { turbo_method: :delete, turbo_confirm: t('pages.groups.edit_work_areas.manage.confirm_deletion') } do %>
              <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
              <%= t('buttons.delete') %>
            <% end %>
          <% end %>
        </div>

        <% participations_by_user = area.area_participations.index_by(&:user_id) %>
        <details class="mt-5 border-t border-base-content/10 pt-3">
          <summary class="flex min-h-11 cursor-pointer items-center gap-2 font-bold">
            <i class="fa-solid fa-users" aria-hidden="true"></i>
            <%= t('pages.groups.edit_quorums.participants') %>
            <span class="badge badge-neutral"><%= participations_by_user.size %></span>
          </summary>
          <ul class="mt-3 divide-y divide-base-content/10" role="list">
            <% @group_participations.each do |participant| %>
              <% participation = participations_by_user[participant.id] %>
              <li id="area_<%= area.id %>_participant_<%= participant.id %>" class="flex min-h-14 items-center justify-between gap-3 py-2">
                <span class="flex min-w-0 items-center gap-3">
                  <%= avatar(participant, size: 32) %>
                  <span class="truncate font-semibold"><%= participant.fullname %></span>
                </span>
                <% if participation %>
                  <%= button_to t('pages.groups.edit_work_areas.manage.remove_participant'),
                                [@group, area, participation],
                                method: :delete,
                                params: { area_participation: { user_id: participant.id } },
                                class: 'btn btn-ghost min-h-11 text-error',
                                form: { data: { turbo_confirm: t('pages.groups.edit_work_areas.manage.confirm_remove_participant', name: participant.fullname) } } %>
                <% else %>
                  <%= button_to t('pages.groups.edit_work_areas.manage.add_participant'),
                                group_group_area_area_participations_path(@group, area),
                                params: { area_participation: { user_id: participant.id } },
                                class: 'btn btn-ghost min-h-11' %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </details>
      </section>
    </li>
  <% end %>
</ul>
<% else %>
  <section class="border border-dashed border-base-content/25 bg-base-100 px-6 py-10 text-center">
    <h2 class="text-xl font-extrabold"><%= t('pages.groups.edit_work_areas.manage.empty_title') %></h2>
    <p class="mx-auto mt-2 max-w-xl text-base-content/70"><%= t('pages.groups.edit_work_areas.manage.empty_description') %></p>
  </section>
<% end %>
