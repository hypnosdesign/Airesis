<ul class="divide-y divide-base-content/10" role="list">
  <% participants.includes(:user).each do |participation| %>
    <li class="flex min-w-0 gap-3 py-3 first:pt-0 last:pb-0">
      <div class="shrink-0"><%= avatar(participation.user, size: 44) %></div>
      <div class="min-w-0 flex-1">
        <p class="break-words font-bold">
          <%= link_to_user participation.user,
                           full_name: true,
                           class: 'inline-flex min-h-11 items-center' %>
        </p>
        <% if participation.guests.positive? %>
          <p class="mt-1 text-sm text-base-content/65"><%= t('pages.events.show.with_guests', field: participation.guests) %></p>
        <% end %>
        <% if participation.comment.present? %>
          <p class="mt-2 break-words text-sm text-base-content/75">“<%= participation.comment %>”</p>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
