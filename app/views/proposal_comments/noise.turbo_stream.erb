<%= turbo_stream.replace "noise_modal" do %>
  <dialog id="noise_modal" data-controller="modal" class="modal" aria-labelledby="noise-title">
    <div class="modal-box shadow-brutal border-2 border-base-content">
      <%= render "proposal_comments/noise" %>
    </div>
    <form method="dialog" class="modal-backdrop" data-action="click->modal#backdropClose">
      <button aria-label="<%= t('buttons.close') %>"><%= t('buttons.close') %></button>
    </form>
  </dialog>
<% end %>
