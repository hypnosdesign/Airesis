<div class="space-y-3">
  <% if @proposal_comment.versions.any? %>
    <% @proposal_comment.versions.reverse_each do |version| %>
      <% restored = version.reify %>
      <% next unless restored %>
      <article class="border-2 border-base-content/15 bg-base-100 p-4">
        <time class="mb-2 block text-xs text-base-content/70" datetime="<%= version.created_at.iso8601 %>"><%= l(version.created_at) %></time>
        <div class="prose max-w-none"><%= parsed_content(restored, @proposal.is_anonima?) %></div>
      </article>
    <% end %>
  <% else %>
    <p class="border-2 border-base-content/15 bg-base-200 p-4"><%= t('pages.proposal_histories.no_revision') %></p>
  <% end %>
</div>
