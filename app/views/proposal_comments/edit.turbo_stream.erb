<%= turbo_stream.replace "comment_#{@proposal_comment.id}" do %>
  <div id="comment_<%= @proposal_comment.id %>" class="bg-warning/10 border-2 border-warning p-5 mb-3 shadow-brutal">
    <h4 class="font-semibold mb-3"><i class="fa-solid fa-pencil"></i> <%= t('pages.proposals.update_comment') %></h4>
    <%= form_with model: [@proposal, @proposal_comment] do |f| %>
      <div class="space-y-3">
        <%= f.label :content, t('pages.proposals.update_comment'), class: 'sr-only' %>
        <%= f.text_area :content, rows: 5, class: 'textarea textarea-bordered min-h-28 w-full', required: true %>
        <div class="flex gap-2">
          <%= f.submit t('buttons.save'), class: 'btn btn-primary min-h-11' %>
          <%= link_to t('buttons.cancel'), proposal_path(@proposal), class: 'btn btn-ghost min-h-11' %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
