<% if @proposal_comment.is_reply? %>
  <%= turbo_stream.append "replies_#{@proposal_comment.parent_proposal_comment_id}" do %>
    <%= render partial: "proposal_comments/reply", locals: { reply: @proposal_comment } %>
  <% end %>
<% else %>
  <%= turbo_stream.prepend "proposalCommentsContainer" do %>
    <%= render partial: "proposal_comments/content", locals: { comment: @proposal_comment } %>
  <% end %>
  <%= turbo_stream.replace "proposalNewComment" do %>
    <div id="proposalNewComment">
      <%= form_with model: [@proposal, ProposalComment.new] do |f| %>
        <p>
          <%= f.label :content do %>
            <%= t('pages.proposals.show.add_contribute') %>
          <% end %>
          <%= f.text_area :content, rows: 6, class: 'textarea textarea-bordered w-full', required: true %>
        </p>
        <p>
          <%= f.submit t('pages.proposals.show.send_contribute_button'), class: 'btn btn-success min-h-11 mt-2' %>
        </p>
      <% end %>
    </div>
  <% end %>
<% end %>
<%= render partial: "layouts/flash_stream" %>
