<% @page_title = t('pages.proposals.comments.replies', default: 'Replies') %>
<%= render layout: 'layouts/page_title', locals: { title: @page_title } do %>
  <%= link_to t('pages.proposal_histories.index.back_to_proposal'), @proposal, class: 'btn btn-outline min-h-11' %>
<% end %>

<div class="space-y-3">
  <% if @replies.any? %>
    <%= render partial: 'proposal_comments/reply', collection: @replies, as: :reply %>
  <% else %>
    <p class="bg-base-200 border-2 border-base-content/15 p-5"><%= t('pages.proposals.show.no_contributes') %></p>
  <% end %>
</div>
