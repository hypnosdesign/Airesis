<%= turbo_stream.replace "manage_noise_modal" do %>
  <dialog id="manage_noise_modal" data-controller="modal" class="modal" aria-labelledby="manage-noise-title">
    <div class="modal-box shadow-brutal border-2 border-base-content max-w-4xl">
      <%= render "proposal_comments/manage_noise" %>
    </div>
    <form method="dialog" class="modal-backdrop" data-action="click->modal#backdropClose">
      <button aria-label="<%= t('buttons.close') %>"><%= t('buttons.close') %></button>
    </form>
  </dialog>
<% end %>
