<%= form_with model: [@proposal, proposal_comment], id: 'new_comment_form' do |f| %>
  <div class="space-y-3">
    <label for="proposal_comment_content" class="font-semibold text-base-content">
      <i class="fa-solid fa-comment-dots"></i>
      <%= t('pages.proposals.show.add_contribute') %>
    </label>
    <%= f.text_area :content, rows: 5, class: 'textarea textarea-bordered min-h-28 w-full', placeholder: t('pages.proposals.show.add_contribute'), required: true %>
    <div class="flex justify-end">
      <%= f.submit t('pages.proposals.show.send_contribute_button'), class: 'btn btn-primary min-h-11' %>
    </div>
  </div>
<% end %>
