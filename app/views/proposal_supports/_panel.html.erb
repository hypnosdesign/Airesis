<% show_heading = local_assigns.fetch(:show_heading, true) %>
<% modal = local_assigns.fetch(:modal, false) %>
<% @available_groups = current_user.scoped_groups(:support_proposals, @proposal.groups) %>

<% if show_heading %>
  <h2 id="proposal-support-title" class="text-xl font-bold"><%= t('pages.proposal_supports.new.panel_title') %></h2>
<% end %>

<% if @available_groups.empty? %>
  <p class="mt-4 border-2 border-info/30 bg-info/10 p-4"><%= t('pages.proposal_supports.new.no_available_groups') %></p>
<% else %>
  <%= form_with model: [@proposal, @proposal_support], class: 'mt-4 space-y-4' do |f| %>
    <fieldset class="space-y-2">
      <legend class="sr-only"><%= t('pages.proposal_supports.new.panel_title') %></legend>
      <% @available_groups.each do |group| %>
        <label class="flex min-h-14 cursor-pointer items-center gap-3 border-2 border-base-content/15 p-3 has-[:checked]:border-primary has-[:checked]:bg-primary/10" for="supporting_group_<%= group.id %>">
          <%= check_box_tag 'proposal[supporting_group_ids][]',
                            group.id,
                            ProposalSupport.exists?(group_id: group.id, proposal_id: @proposal.id),
                            id: "supporting_group_#{group.id}",
                            class: 'checkbox checkbox-primary' %>
          <%= image_tag(group.image.attached? ? url_for(group.image) : asset_path('gruppo-anonimo.png'),
                        alt: '', width: 32, height: 32, class: 'size-8 shrink-0 object-cover') %>
          <span class="font-semibold"><%= group.name %></span>
        </label>
      <% end %>
    </fieldset>

    <div class="flex flex-wrap gap-2">
      <% if modal %>
        <button type="button" class="btn btn-outline min-h-11" data-action="modal#close"><%= t('buttons.cancel') %></button>
      <% else %>
        <%= link_to t('buttons.cancel'), proposal_path(@proposal), class: 'btn btn-outline min-h-11' %>
      <% end %>
      <%= f.submit t('pages.proposal_supports.confirm_button'), class: 'btn btn-primary min-h-11', data: { disable_with: t('loading') } %>
    </div>
  <% end %>
<% end %>
