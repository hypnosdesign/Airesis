<% @noleft = true %>
<% @page_title = 'Cookie Policy' %>
<main class="content-shell">
  <header class="mx-auto mb-8 max-w-3xl">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl"><%= @page_title %></h1>
    <p class="mt-3 text-base leading-relaxed text-base-content/70">What cookies are used for and how you can control them in your browser.</p>
  </header>
  <section class="info-section" aria-label="Cookie policy text">
    <%= render partial: 'devise/registrations/cookies' %>
  </section>
</main>
