<% @noleft = true %>
<% @page_title = 'Privacy Policy' %>
<main class="content-shell">
  <header class="mx-auto mb-8 max-w-3xl">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl"><%= @page_title %></h1>
    <p class="mt-3 text-base leading-relaxed text-base-content/70">How personal data is collected, used, retained and protected when you use this service.</p>
    <nav class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Privacy policy sections">
      <a class="inline-flex min-h-11 items-center link link-primary" href="#privacy-collection">Collection and use</a>
      <a class="inline-flex min-h-11 items-center link link-primary" href="#privacy-rights">Your rights</a>
      <a class="inline-flex min-h-11 items-center link link-primary" href="#privacy-providers">Service providers</a>
      <a class="inline-flex min-h-11 items-center link link-primary" href="#privacy-contact">Contact</a>
    </nav>
  </header>
  <section class="info-section" aria-label="Privacy policy text">
    <%= render partial: 'devise/registrations/privacy' %>
  </section>
</main>
