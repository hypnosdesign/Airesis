<%= turbo_stream.replace "privacy_modal" do %>
  <dialog id="privacy_modal" data-controller="modal" class="modal" aria-labelledby="privacy_modal_title">
    <div class="modal-box max-h-[85vh] max-w-3xl border border-base-content/15">
      <h3 id="privacy_modal_title" class="text-lg font-bold mb-4"><%= t('words.privacy_policy') %></h3>
      <div class="max-h-[60vh] overflow-y-auto pr-2 text-sm">
        <%= render partial: "devise/registrations/privacy" %>
      </div>
      <div class="modal-action">
        <button class="btn" data-action="click->modal#close" data-modal-target="initialFocus"><%= t('buttons.close') %></button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop" data-action="click->modal#backdropClose">
      <button aria-label="<%= t('buttons.close') %>"></button>
    </form>
  </dialog>
<% end %>
