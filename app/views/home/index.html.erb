<!DOCTYPE html>
<html class="no-js" lang="<%= I18n.locale %>" data-theme="nord">
  <head>
    <meta charset="utf-8">
    <title><%= t('home.tags.title') %></title>
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= t('home.tags.description') %>">
    <meta property="og:title" content="<%= t('home.tags.title') %>">
    <meta property="og:type" content="website">
    <meta property="og:image" content="<%= asset_url('logo120.png') %>">
    <meta property="og:site_name" content="<%= ENV['APP_LONG_NAME'] %>">
    <meta property="og:description" content="<%= t('home.tags.description') %>">
    <meta property="fb:app_id" content="<%= ENV['FACEBOOK_APP_ID'] %>">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <%= render 'layouts/favicons' %>
  </head>

  <body class="bg-base-200 min-h-screen">

    <%# ===== NAVBAR ===== %>
    <nav class="navbar bg-secondary text-secondary-content border-b-3 border-neutral sticky top-0 z-50"
         style="box-shadow: 0 12px 30px -22px currentColor;">
      <div class="max-w-7xl mx-auto w-full px-4 flex justify-between items-center">
        <a href="#hero" class="inline-flex min-h-11 items-center text-2xl font-extrabold tracking-tight">
          <%= APP_SHORT_NAME.presence || 'Decidiamoci' %>
        </a>

        <div class="flex items-center gap-6">
          <nav class="hidden md:flex gap-8">
            <%= link_to t('pages.home.index.whatis'), '#hero',
                class: 'inline-flex min-h-11 items-center font-semibold hover:-translate-y-0.5 hover:-rotate-1 hover:scale-105 transition-transform' %>
            <%= link_to t('pages.home.index.features'), '#features',
                class: 'inline-flex min-h-11 items-center font-semibold hover:-translate-y-0.5 hover:-rotate-1 hover:scale-105 transition-transform' %>
            <%= link_to t('pages.home.index.register'), new_user_registration_path,
                class: 'inline-flex min-h-11 items-center font-semibold hover:-translate-y-0.5 hover:-rotate-1 hover:scale-105 transition-transform' %>
          </nav>

          <button type="button"
             onclick="document.getElementById('language').showModal()"
             class="tap-target hover:opacity-80 transition"
             aria-label="<%= t('pages.home.index.change_language') %>">
            <%= image_tag "flags/#{I18n.locale}.png", class: 'h-5', alt: '', title: t('pages.home.index.change_language') %>
          </button>

          <div class="flex gap-3">
            <a href="https://www.facebook.com/airesisit" target="_blank" rel="noopener noreferrer"
               aria-label="Facebook" class="tap-target hover:scale-110 transition-transform">
              <i class="fa-brands fa-facebook text-lg"></i>
            </a>
            <a href="https://twitter.com/democracyo" target="_blank" rel="noopener noreferrer"
               aria-label="X / Twitter" class="tap-target hover:scale-110 transition-transform">
              <i class="fa-brands fa-x-twitter text-lg"></i>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <main>
    <%# ===== HERO SECTION ===== %>
    <section id="hero" class="bg-base-100 border-b-2 border-neutral">
      <div class="max-w-7xl mx-auto px-4 py-16 md:py-24 flex flex-col md:flex-row items-center gap-12 md:gap-20">

        <%# Left: headline + CTA %>
        <div class="flex-1 space-y-6">
          <h1 class="text-4xl md:text-6xl font-extrabold leading-tight text-base-content">
            <%= t('home.intro.paragraph_1.title') %>
          </h1>
          <p class="text-lg md:text-xl text-base-content/80 max-w-lg">
            <%= t('home.tags.description') %>
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <%= link_to t('pages.home.index.explore_public', default: 'Explore public decisions'), open_space_path,
                class: 'btn btn-primary min-h-11 border-3 border-neutral text-lg px-8' %>
            <%= link_to t('pages.home.index.how_decisions_work', default: 'How decisions work'), edemocracy_path,
                class: 'btn btn-ghost min-h-11 border-3 border-neutral text-lg px-8' %>
          </div>
        </div>

        <%# Right: focused member entry point %>
        <div class="w-full md:w-[400px] bg-base-200 border-3 border-neutral p-8 space-y-5"
             style="box-shadow: 0 24px 55px -30px currentColor;">
          <div class="flex size-14 items-center justify-center border-2 border-neutral bg-secondary text-secondary-content">
            <i class="fa-solid fa-landmark text-xl" aria-hidden="true"></i>
          </div>
          <h2 class="text-2xl font-bold text-base-content"><%= t('pages.home.index.member_title', default: 'Already part of a community?') %></h2>
          <p class="leading-relaxed text-base-content/70"><%= t('pages.home.index.member_description', default: 'Sign in to continue a discussion, refine a proposal or take part in a vote.') %></p>
          <%= link_to new_user_session_path, class: 'btn btn-secondary min-h-11 w-full border-3 border-neutral text-lg font-bold' do %>
            <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
            <%= t('pages.home.index.login') %>
          <% end %>
          <p class="text-sm text-base-content/60">
            <%= t('pages.home.index.new_here', default: 'New here?') %>
            <%= link_to t('pages.home.index.explore_first', default: 'Explore the public space first'), open_space_path, class: 'inline-flex min-h-11 items-center font-semibold text-primary underline' %>
          </p>
        </div>
      </div>
    </section>

    <%# ===== FEATURES SECTION ===== %>
    <section id="features" class="bg-base-200 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl md:text-5xl font-extrabold text-center text-base-content mb-16">
          <%= t('pages.home.index.features_title', default: 'From ideas to accountable decisions') %>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <%
            features = [
              {
                icon: 'fa-users',
                color: 'bg-accent',
                title: t('home.whatis.paragraph_2.title'),
                desc: t('home.whatis.paragraph_2.content_html', groups: Group.count)
              },
              {
                icon: 'fa-lightbulb',
                color: 'bg-primary',
                title: t('home.whatis.paragraph_4.title'),
                desc: t('home.whatis.paragraph_4.content_html', users: User.count, proposals: Proposal.count)
              },
              {
                icon: 'fa-calendar-check',
                color: 'bg-warning',
                title: t('home.whatis.paragraph_5.title'),
                desc: t('home.whatis.paragraph_5.content_html')
              },
              {
                icon: 'fa-comments',
                color: 'bg-secondary',
                title: t('home.whatis.paragraph_3.title'),
                desc: t('home.whatis.paragraph_3.content_html')
              }
            ]
          %>

          <% features.each do |f| %>
            <div class="bg-base-100 border-3 border-neutral p-8 space-y-4"
                 style="box-shadow: 0 18px 40px -28px currentColor;">
              <div class="h-1.5 w-full <%= f[:color] %>"></div>
              <div class="inline-flex items-center justify-center w-14 h-14 border-2 border-neutral <%= f[:color] %>"
                   style="box-shadow: 0 10px 22px -16px currentColor;">
                <i class="fa-solid <%= f[:icon] %> text-xl"></i>
              </div>
              <h3 class="text-2xl font-bold text-base-content"><%= f[:title] %></h3>
              <p class="text-base-content/80 leading-relaxed"><%= f[:desc] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <%# ===== TESTIMONIALS ===== %>
    <section class="bg-secondary text-secondary-content border-y-2 border-neutral py-16 md:py-24">
      <div class="max-w-5xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-12">
          <%= t('pages.home.index.testimonials_title', default: 'Voices on democratic participation') %>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <% [
               { text: 'Quae optima sunt, esse communia.', author: 'Lucio Anneo Seneca' },
               { text: 'The tragedy of modern democracies is that they have not yet succeeded in effecting democracy.', author: 'Jacques Maritain' },
               { text: 'Nothing is stronger than an idea whose time has come.', author: 'Victor Hugo' }
             ].each do |q| %>
            <blockquote class="bg-base-100 text-base-content border-3 border-neutral p-7 text-left space-y-4"
                        style="box-shadow: 0 18px 40px -28px currentColor;">
              <p class="text-base italic leading-relaxed">"<%= q[:text] %>"</p>
              <cite class="block font-bold text-base-content text-sm not-italic">&mdash; <%= q[:author] %></cite>
            </blockquote>
          <% end %>
        </div>
      </div>
    </section>

    </main>

    <%# ===== FOOTER ===== %>
    <footer class="bg-neutral text-neutral-content py-12">
      <div class="max-w-7xl mx-auto px-4 flex flex-col items-center gap-4 text-center">
        <span class="text-2xl font-extrabold"><%= APP_SHORT_NAME.presence || 'Decidiamoci' %></span>
        <p class="text-neutral-content/80 text-sm">
          <%= t('pages.home.index.footer_description', default: 'Open-source infrastructure for participatory democracy') %>
        </p>
        <div class="flex gap-4">
          <a href="https://www.facebook.com/airesisit/" target="_blank" rel="noopener noreferrer"
             aria-label="Facebook" class="tap-target hover:text-primary transition">
            <i class="fa-brands fa-facebook text-xl"></i>
          </a>
          <a href="https://twitter.com/democracyo" target="_blank" rel="noopener noreferrer"
             aria-label="X / Twitter" class="tap-target hover:text-primary transition">
            <i class="fa-brands fa-x-twitter text-xl"></i>
          </a>
          <a href="https://github.com/airesis/airesis" target="_blank" rel="noopener noreferrer"
             aria-label="GitHub" class="tap-target hover:text-primary transition">
            <i class="fa-brands fa-github text-xl"></i>
          </a>
        </div>
        <p class="text-neutral-content/30 text-xs">
          v.<%= APP_VERSION %> · <%= t('pages.home.index.airesis_attribution', default: 'Built on Airesis') %> · AGPL
        </p>
        <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm" aria-label="<%= t('pages.home.index.legal_navigation', default: 'Legal information') %>">
          <%= link_to t('terms_of_service'), terms_path, class: 'inline-flex min-h-11 items-center underline hover:text-primary' %>
          <%= link_to t('privacy_policy'), privacy_path, class: 'inline-flex min-h-11 items-center underline hover:text-primary' %>
          <%= link_to t('cookie_policy'), cookie_law_path, class: 'inline-flex min-h-11 items-center underline hover:text-primary' %>
        </nav>
        <a href="#hero" aria-label="<%= t('pages.home.index.back_to_top', default: 'Back to top') %>"
           class="btn btn-ghost btn-sm min-w-11 border border-neutral-content/20 mt-2">
          <i class="fa-solid fa-chevron-up"></i>
        </a>
      </div>
    </footer>

    <%= render 'layouts/languages' %>
  </body>
</html>
