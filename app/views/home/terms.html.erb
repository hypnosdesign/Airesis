<% @noleft = true %>
<% @page_title = t('words.terms_of_service') %>
<main class="content-shell">
  <header class="mx-auto mb-8 max-w-3xl">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl"><%= t('words.terms_of_service') %></h1>
    <p class="mt-3 text-base leading-relaxed text-base-content/80">
      This legal document is currently available in Italian.
      <% if service_contact_email.present? %>
        Contact <%= mail_to service_contact_email, service_contact_email, class: 'font-semibold text-primary underline' %> before registering if you need clarification.
      <% else %>
        The service operator has not configured a public contact address for this environment.
      <% end %>
    </p>
  </header>
  <section class="info-section" aria-label="Terms of Service">
    <div class="article-body" lang="it">
      <%= render partial: 'devise/registrations/eula' %>
    </div>
  </section>
</main>
