<% @page_title = "#{@topic.subject} - #{@group.name}" %>
<% @extend = true %>

<div id="topic" class="<%= @topic.locked? ? 'locked' : 'unlocked' %>">
  <%= render partial: 'frm/topics/head', locals: { topic: @topic } %>

  <header class="mb-6">
    <div class="flex flex-wrap items-center gap-2">
      <% if @topic.pinned? %><span class="badge badge-primary badge-outline"><%= t('simple_form.labels.topic.pinned') %></span><% end %>
      <% if @topic.locked? %><span class="badge badge-outline"><%= t('simple_form.labels.topic.locked') %></span><% end %>
      <% if @topic.pending_review? %><span class="badge badge-warning"><%= t('frm.moderation.status.pending') %></span><% end %>
    </div>
    <h1 class="mt-2 max-w-4xl text-3xl font-bold leading-tight tracking-tight"><%= @topic.subject %></h1>
    <p class="mt-2 text-sm text-base-content/60"><%= t('started_by') %><%= @topic.user || t('frm.posts.post.deleted_user') %></p>
  </header>

  <% if @topic.pending_review? %>
    <div id="topic_moderation" class="moderation mb-6 rounded-box border border-warning/40 bg-warning/10 p-4" role="status">
      <p class="font-medium"><%= t("frm.topics.show.pending_review") %></p>
      <% if forem_admin_or_moderator?(@topic.forum) %>
        <%= form_with model: @topic, url: group_frm_moderate_forum_topic_url(@group, @forum, @topic), method: :put, class: "mt-4" do |f| %>
          <%= render "/frm/moderation/options", f: f, submit: true %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="mb-6 flex flex-wrap items-center gap-3" aria-label="<%= t('frm.forum.topic_tools') %>">
    <% if @topic.can_be_replied_to? && can?(:reply, @topic) %>
      <%= link_to new_group_forum_topic_post_url(@group, @forum, @topic), class: "btn btn-primary min-h-11", data: { disable_with: t('loading') } do %>
        <i class="fa-solid fa-comments" aria-hidden="true"></i>
        <%= t(".reply") %>
      <% end %>
    <% end %>
    <%= render 'proposals/new_proposal' %>
    <% if current_user %>
      <div data-subscribe-container><%= render partial: 'subscribe_button' %></div>
    <% end %>
    <% if @topic.user == current_user || forem_admin?(@group) %>
      <%= link_to group_forum_topic_url(@group, @forum, @topic), data: { turbo_method: :delete, turbo_confirm: t("are_you_sure") }, class: "btn btn-error btn-outline min-h-11" do %>
        <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
        <%= t(".delete") %>
      <% end %>
    <% end %>
  </div>

  <%= forem_pages_widget(@pagy) %>
  <div id="posts" class="posts space-y-4" aria-label="<%= t('posts', scope: 'frm.general') %>">
    <%= render partial: "frm/posts/post", collection: @posts %>
  </div>
  <%= forem_pages_widget(@pagy) %>

  <% if @topic.proposals.count > 0 %>
    <section class="mt-8 border-t border-base-300 pt-6" aria-labelledby="related_proposals_title">
      <h2 id="related_proposals_title" class="text-xl font-bold"><%= t('.related_proposals') %></h2>
      <div class="mt-3 flex flex-wrap gap-2">
      <% @topic.proposals.each do |proposal| %>
        <%= proposal_tag proposal %>
      <% end %>
      </div>
    </section>
  <% end %>

  <% if forem_admin?(@group) %>
    <details class="mt-8 rounded-box border border-base-300 bg-base-100 p-4">
      <summary class="min-h-11 cursor-pointer font-semibold"><%= t('frm.forum.admin_tools') %></summary>
      <div class="mt-4 flex flex-wrap gap-3">
        <%= link_to edit_group_frm_admin_forum_topic_url(@group, @forum, @topic), class: "btn btn-outline min-h-11" do %>
          <i class="fa-solid fa-pencil" aria-hidden="true"></i>
          <%= t('frm.topic.links.edit') %>
        <% end %>
        <%= link_to toggle_hide_group_frm_admin_forum_topic_url(@group, @forum, @topic), data: { turbo_method: :put, disable_with: t('loading') }, class: "btn btn-outline min-h-11" do %>
          <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
          <%= t("frm.topics.show.hide.#{@topic.hidden}") %>
        <% end %>
        <%= link_to toggle_lock_group_frm_admin_forum_topic_url(@group, @forum, @topic), data: { turbo_method: :put, disable_with: t('loading') }, class: "btn btn-outline min-h-11" do %>
          <i class="fa-solid fa-lock" aria-hidden="true"></i>
          <%= t("frm.topics.show.lock.#{@topic.locked}") %>
        <% end %>
        <%= link_to toggle_pin_group_frm_admin_forum_topic_url(@group, @forum, @topic), data: { turbo_method: :put, disable_with: t('loading') }, class: "btn btn-outline min-h-11" do %>
          <i class="fa-solid fa-thumbtack" aria-hidden="true"></i>
          <%= t("frm.topics.show.pin.#{@topic.pinned}") %>
        <% end %>
      </div>
    </details>
  <% end %>
</div>

<%= render partial: '/frm/application/forem_footer' %>
