<%= render partial: 'frm/forums/head', locals: { forum: @topic.forum } %>

<div class="max-w-3xl">
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight"><%= t("frm.post.new") %> “<%= @topic.subject %>”</h1>
    <p class="mt-2 text-base-content/70"><%= t('frm.post.form.description') %></p>
  </header>
  <% if @reply_to_post %>
    <div class="mb-5"><%= render 'reply_to_post', post: @reply_to_post %></div>
  <% end %>
  <div class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
    <%= simple_form_for @post, url: group_forum_topic_posts_url(@group, @topic.forum, @topic) do |f| %>
      <%= render partial: "form", locals: { f: f } %>
      <div class="mt-5 flex flex-wrap gap-3">
        <%= f.submit t("frm.post.buttons.reply"), class: "btn btn-primary min-h-11", data: { disable_with: t('loading') } %>
        <%= link_to t('buttons.cancel'), group_forum_topic_path(@group, @topic.forum, @topic), class: "btn btn-ghost min-h-11" %>
      </div>
    <% end %>
  </div>
</div>
