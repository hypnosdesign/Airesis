<%= render partial: 'frm/forums/head', locals: { forum: @topic.forum } %>

<div class="max-w-3xl">
  <h1 class="mb-6 text-3xl font-bold tracking-tight"><%= t('frm.post.edit') %></h1>
  <div class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
    <%= simple_form_for @post, url: group_forum_topic_post_url(@group, @topic.forum, @topic, @post) do |f| %>
      <%= render partial: 'form', locals: { f: f } %>
      <div class="mt-5 flex flex-wrap gap-3">
        <%= f.submit t("frm.post.buttons.edit"), class: 'btn btn-primary min-h-11', data: { disable_with: t('loading') } %>
        <%= link_to t('buttons.cancel'), group_forum_topic_path(@group, @topic.forum, @topic), class: "btn btn-ghost min-h-11" %>
      </div>
    <% end %>
  </div>
</div>
