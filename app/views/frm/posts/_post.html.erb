<article id="post_<%= post_counter + 1 %>" class="post-container rounded-box border border-base-300 bg-base-100 p-4 sm:p-5" aria-labelledby="post_<%= post.id %>_author">
  <span id="post-<%= post.id %>" class="block scroll-mt-24" aria-hidden="true"></span>

  <% if post.pending_review? %>
    <div class="moderation mb-4 rounded-box border border-warning/40 bg-warning/10 p-4" role="status">
      <p class="font-medium"><%= t(".pending_review") %></p>
      <% if forem_admin_or_moderator?(post.topic.forum) %>
        <% if local_assigns[:mass_moderation] %>
          <div class="mt-3"><%= render "/frm/posts/moderation_tools", post: post, submit: false %></div>
        <% else %>
          <%= form_tag group_frm_forum_moderate_posts_url(@group, post.topic.forum), method: :put, class: "mt-3" do %>
            <%= render "/frm/posts/moderation_tools", post: post, submit: true %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <header class="flex flex-col gap-3 border-b border-base-200 pb-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex min-w-0 items-center gap-3">
      <div class="shrink-0"><%= avatar(post.user, size: 48) if post.user %></div>
      <div class="min-w-0">
        <p id="post_<%= post.id %>_author" class="truncate font-semibold">
          <%= post.user ? link_to(post.user.fullname, post.user, class: "underline-offset-4 hover:underline") : t('frm.posts.post.deleted_user') %>
        </p>
        <p class="post-when mt-1 text-sm text-base-content/60">
          <a href="#post-<%= post.id %>" class="rounded-sm underline-offset-4 hover:underline">
            <time datetime="<%= post.created_at.iso8601 %>"><%= time_ago_in_words(post.created_at) %></time>
          </a>
          <% if post.reply_to %>
            · <%= link_to "#{t(".in_reply_to")} #{post.reply_to.user || t('frm.posts.post.deleted_user')}", "#post-#{post.reply_to.id}", class: "in-reply-to underline-offset-4 hover:underline" %>
          <% end %>
        </p>
      </div>
    </div>

    <% if current_user %>
      <div class="flex flex-wrap gap-2" aria-label="<%= t('frm.post.actions') %>">
        <% if can?(:reply, post.topic) && post.topic.can_be_replied_to? %>
          <%= link_to t('reply', scope: 'frm.topic'), new_group_forum_topic_post_url(@group, post.topic.forum, post.topic, reply_to_id: post.id), class: 'btn btn-ghost min-h-11' %>
          <%= link_to t('quote', scope: 'frm.topic'), new_group_forum_topic_post_url(@group, post.topic.forum, post.topic, reply_to_id: post.id, quote: true), class: 'btn btn-ghost min-h-11' %>
        <% end %>
        <% if post.owner_or_moderator?(current_user) %>
          <% if can?(:edit_post, post.topic.forum) %>
            <%= link_to t('edit', scope: 'frm.post.buttons'), edit_group_forum_topic_post_url(@group, post.topic.forum, post.topic, post), class: 'btn btn-ghost min-h-11' %>
          <% end %>
          <%= link_to t('delete', scope: 'frm.topic'), group_forum_topic_post_url(@group, post.topic.forum, post.topic, post), data: { turbo_method: :delete, turbo_confirm: t("are_you_sure") }, class: 'btn btn-error btn-outline min-h-11' %>
        <% end %>
      </div>
    <% end %>
  </header>

  <div class="post_content pt-4">
    <div class="post-body prose max-w-[75ch]"><%= post.text %></div>
  </div>
</article>
