<figure class="rounded-box border border-base-300 bg-base-200/40 p-4">
  <figcaption class="flex items-center gap-3">
    <%= avatar(post.user, size: 44) if post.user %>
    <div>
      <p class="font-semibold"><%= post.user ? link_to(post.user.fullname, post.user) : t('frm.posts.post.deleted_user') %></p>
      <p class="text-sm text-base-content/60"><time datetime="<%= post.created_at.iso8601 %>"><%= time_ago_in_words(post.created_at) %></time></p>
    </div>
  </figcaption>
  <blockquote class="post-body prose mt-4 max-w-[75ch]"><%= post.text %></blockquote>
</figure>
