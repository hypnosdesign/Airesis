<% unless local_assigns[:show_heading] == false %>
  <h2 id="category_modal_title" class="text-xl font-bold mb-4"><%= t('new', scope: 'frm.admin.category') %></h2>
<% end %>

<%= simple_form_for @category, url: group_frm_admin_categories_url(@group), html: { data: { turbo: local_assigns.fetch(:turbo, true) } } do |f| %>
  <%= f.input :name %>
  <%= f.input :tags_list %>
  <%= f.input :visible_outside, inline_label: true %>
  <div class="flex gap-2 mt-4">
    <%= link_to t('buttons.cancel'), group_frm_admin_categories_path(@group), class: 'btn btn-ghost min-h-11', data: { action: "click->modal#close" } %>
    <%= f.submit class: "btn btn-primary min-h-11", data: { disable_with: t('loading') } %>
  </div>
<% end %>
