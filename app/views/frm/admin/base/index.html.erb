<% @page_title = "#{@group.name} - #{t('frm.admin.area')}" %>
<div class="max-w-4xl">
  <header>
    <h1 class="text-3xl font-bold tracking-tight"><%= t('frm.admin.area') %></h1>
    <p class="mt-2 text-base-content/70"><%= t('frm.admin.description', group: @group.name) %></p>
  </header>
  <div class="mt-6 divide-y divide-base-300 rounded-box border border-base-300 bg-base-100">
    <%= link_to group_frm_admin_categories_url(@group), class: 'flex min-h-16 items-center justify-between gap-4 p-4 hover:bg-base-200/50' do %>
      <span><strong class="block"><%= t('frm.admin.category.index') %></strong><span class="mt-1 block text-sm text-base-content/60"><%= t('frm.admin.category.description') %></span></span>
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    <% end %>
    <%= link_to group_frm_admin_forums_url(@group), class: 'flex min-h-16 items-center justify-between gap-4 p-4 hover:bg-base-200/50' do %>
      <span><strong class="block"><%= t('frm.admin.forum.index') %></strong><span class="mt-1 block text-sm text-base-content/60"><%= t('frm.admin.forum.description') %></span></span>
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    <% end %>
    <%= link_to group_frm_admin_mods_url(@group), class: 'flex min-h-16 items-center justify-between gap-4 p-4 hover:bg-base-200/50' do %>
      <span><strong class="block"><%= t('frm.admin.mod.index') %></strong><span class="mt-1 block text-sm text-base-content/60"><%= t('frm.admin.mod.description') %></span></span>
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>
  <div id="admin_link" class="mt-6">
    <%= link_to group_forums_url(@group), class: 'btn btn-ghost min-h-11' do %>
      <%= t('back_to_forums') %>
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    <% end %>
  </div>
</div>

<% content_for :left_panel do %>
  <%= render 'groups/administration_panel' %>
<% end %>
