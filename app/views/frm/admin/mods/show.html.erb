<nav class="breadcrumbs text-sm mb-6" aria-label="<%= t('frm.navigation.breadcrumbs') %>">
  <ul>
    <li><%= link_to t('pages.groups.administration_panel.forum'), group_frm_admin_root_url(@group) %></li>
    <li><%= link_to t('frm.admin.group.index'), group_frm_admin_mods_url(@group) %></li>
    <li><%= @frm_mod.name %></li>
  </ul>
</nav>

<div class="max-w-4xl">
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight"><%= @frm_mod.name %></h1>
    <p class="mt-2 text-base-content/70"><%= t('frm.admin.mod.members_description') %></p>
  </header>
  <section aria-labelledby="add_member_title">
    <h2 id="add_member_title" class="text-xl font-bold"><%= t('frm.admin.mods.show.add_a_new_member') %></h2>
    <div class="add-member-form mt-3 rounded-box border border-base-300 bg-base-100 p-4"><%= render 'frm/admin/mods/add_form' %></div>
  </section>
  <section class="mt-8 border-t border-base-300 pt-6" aria-labelledby="current_members_title">
    <h2 id="current_members_title" class="text-xl font-bold"><%= t('frm.admin.mods.show.current_members') %></h2>
    <div id="group_members_container" class="mt-3"><%= render 'group_members' %></div>
  </section>
</div>
  </div>
</div>

<% content_for :left_panel do %>
  <%= render 'groups/administration_panel' %>
<% end %>
