<%= turbo_stream.replace "mod_modal" do %>
  <dialog id="mod_modal" data-controller="modal" class="modal" aria-labelledby="mod_modal_title">
    <div class="modal-box border border-base-300">
      <%= render partial: "form", locals: { turbo: true } %>
    </div>
    <form method="dialog" class="modal-backdrop" data-action="click->modal#backdropClose">
      <button>close</button>
    </form>
  </dialog>
<% end %>
