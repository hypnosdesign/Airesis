<div id="add_member_form">
<%= form_tag add_group_frm_admin_mod_members_url(@group, @frm_mod) do %>
  <div class="inputs mb-2">
    <%= label_tag 'frm_user_id', t('frm.admin.mods.show.add_a_new_member'), class: "label font-medium" %>
    <%= select_tag 'frm_user_id',
                   options_from_collection_for_select(@group.participants.order(:surname, :name).limit(100), :id, :fullname),
                   include_blank: t('frm.admin.mods.show.select_member'),
                   class: 'select select-bordered min-h-11 w-full',
                   required: true %>
  </div>
  <p>
    <%= submit_tag t('frm.admin.mods.show.add_member'), class: 'btn btn-primary min-h-11', data: { disable_with: t('loading') } %>
  </p>
<% end %>
</div>
