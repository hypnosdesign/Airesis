<nav class="breadcrumbs text-sm mb-6" aria-label="<%= t('frm.navigation.breadcrumbs') %>">
  <ul>
    <li><%= link_to t('pages.groups.administration_panel.forum'), group_frm_admin_root_url(@group) %></li>
    <li><%= t("frm.admin.forum.index") %></li>
  </ul>
</nav>

<div>
  <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight"><%= t('frm.admin.forum.index') %></h1>
      <p class="mt-2 text-base-content/70"><%= t('frm.admin.forum.description') %></p>
    </div>
    <%= link_to new_group_frm_admin_forum_url(@group), class: "btn btn-primary min-h-11" do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
      <%= t("frm.admin.forum.new_link") %>
    <% end %>
  </header>

  <% if @forums.any? %>
    <div class="space-y-8">
      <% @forums.group_by(&:category).each do |category, forums| %>
        <section class="category" aria-labelledby="admin_forum_category_<%= category&.id || 'none' %>">
          <h2 id="admin_forum_category_<%= category&.id || 'none' %>" class="mb-3 text-xl font-bold"><%= category.try(:name) || t('.no_category') %></h2>
          <div class="divide-y divide-base-300 rounded-box border border-base-300 bg-base-100">
            <% forums.each do |forum| %>
              <article class="forum p-4 sm:p-5">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                  <div class="min-w-0 max-w-3xl">
                    <h3 class="text-lg font-semibold"><%= link_to forum.title, group_forum_url(@group, forum), class: "underline-offset-4 hover:underline" %></h3>
                    <div class="mt-1 text-sm text-base-content/70"><%= forem_format(forum.description) %></div>
                    <p class="mt-3 text-sm text-base-content/60"><strong class="text-base-content"><%= forum.topics.count %></strong> <%= t('topics', scope: 'frm.general').downcase %> · <strong class="text-base-content"><%= forum.posts.count %></strong> <%= t('posts', scope: 'frm.general').downcase %></p>
                    <p class="moderators mt-2 text-sm"><strong><%= t('.moderators') %>:</strong> <%= forum.mods.any? ? safe_join(forum.mods.map { |moderator| link_to(moderator, group_frm_admin_mod_url(@group, moderator)) }, ', ') : t('frm.admin.forums.index.none') %></p>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <%= link_to edit_group_frm_admin_forum_url(@group, forum), class: "btn btn-ghost min-h-11" do %><i class="fa-solid fa-pencil" aria-hidden="true"></i><%= t('edit', scope: 'frm.admin.forums') %><% end %>
                    <%= link_to group_frm_admin_forum_url(@group, forum), data: { turbo_method: :delete, turbo_confirm: t("delete_confirm", scope: "frm.admin.forums") }, class: "btn btn-error btn-outline min-h-11" do %><i class="fa-regular fa-trash-can" aria-hidden="true"></i><%= t('delete', scope: 'frm.admin.forums') %><% end %>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-box border border-base-300 bg-base-100 p-6 text-base-content/70" role="status"><%= t('frm.admin.forum.empty') %></p>
  <% end %>
</div>

<%= render partial: '/frm/application/forem_footer' %>

<% content_for :left_panel do %>
  <%= render partial: 'groups/administration_panel' %>
<% end %>
