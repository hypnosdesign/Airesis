<% @page_title = t('frm.forum.title') %>

<nav class="breadcrumbs text-sm mb-6" aria-label="<%= t('frm.navigation.breadcrumbs') %>">
  <ul>
    <li><%= link_to t('pages.groups.administration_panel.forum'), group_frm_admin_root_url(@group) %></li>
    <li><%= link_to t('frm.admin.forum.index'), group_frm_admin_forums_url(@group) %></li>
    <li><%= t("frm.forum.new") %></li>
  </ul>
</nav>

<div class="max-w-3xl">
  <h1 class="mb-6 text-3xl font-bold tracking-tight"><%= t("frm.forum.new") %></h1>
  <% if @group.categories.none? %>
    <div class="rounded-box border border-warning/40 bg-warning/10 p-5" role="alert">
      <h2 class="font-semibold"><%= t('frm.admin.forum.form.no_categories_title') %></h2>
      <p class="mt-2 text-sm"><%= t('frm.admin.forum.form.no_categories_description') %></p>
      <%= link_to t('frm.admin.category.new_link'), new_group_frm_admin_category_path(@group), class: "btn btn-primary mt-4 min-h-11" %>
    </div>
  <% else %>
    <div class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
      <%= simple_form_for @forum, url: group_frm_admin_forums_url(@group) do |f| %>
        <%= render partial: 'form', locals: { f: f } %>
      <% end %>
    </div>
  <% end %>
</div>

<% content_for :left_panel do %>
  <%= render partial: 'groups/administration_panel' %>
<% end %>
