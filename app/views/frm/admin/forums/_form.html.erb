<div class="space-y-5">
  <%= f.input :category_id, collection: @group.categories.all.map { |r| [r.name, r.id, { 'data-tags' => r.tags_data }] }, hint: t('frm.admin.forum.form.category_hint') %>
  <%= f.input :name, input_html: { class: "min-h-11" } %>
  <%= f.input :description, as: :text, input_html: { rows: 5 }, hint: t('frm.admin.forum.form.description_hint') %>
  <%= f.input :tags_list %>
  <%= f.input :visible_outside, hint: t('frm.admin.forum.form.visibility_hint') %>

  <fieldset class="border-t border-base-300 pt-5">
    <legend class="text-lg font-bold"><%= t('frm.admin.forum.moderator_groups') %></legend>
    <p class="mt-1 text-sm text-base-content/60"><%= t('frm.admin.forum.form.moderators_hint') %></p>
    <div class="mt-3"><%= f.association :mods, collection: @group.mods, as: :check_boxes, label: false %></div>
  </fieldset>
  <div class="flex flex-wrap gap-3">
    <%= f.submit class: "btn btn-primary min-h-11", data: { disable_with: t('loading') } %>
    <%= link_to t('buttons.cancel'), group_frm_admin_forums_path(@group), class: "btn btn-ghost min-h-11" %>
  </div>
</div>
