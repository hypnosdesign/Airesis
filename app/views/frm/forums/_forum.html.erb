<% if can?(:read, forum) %>
  <article class="forum p-4 sm:p-5" role="listitem">
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
      <div class="min-w-0">
        <h3 class="text-lg font-semibold">
          <%= link_to forum.title, group_forum_url(@group, forum), class: "title inline-flex min-h-11 items-center rounded-sm underline-offset-4 hover:underline" %>
        </h3>
        <div class="description mt-1 max-w-3xl text-sm text-base-content/70"><%= forem_format(forum.description) %></div>
        <dl class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-base-content/70">
          <div><dt class="sr-only"><%= t('topics', scope: 'frm.general') %></dt><dd><strong class="tabular-nums text-base-content"><%= topics_count(forum) %></strong> <%= t('topics', scope: 'frm.general').downcase %></dd></div>
          <div><dt class="sr-only"><%= t('posts', scope: 'frm.general') %></dt><dd><strong class="tabular-nums text-base-content"><%= posts_count(forum) %></strong> <%= t('posts', scope: 'frm.general').downcase %></dd></div>
          <div><dt class="sr-only"><%= t('frm.forums.index.views') %></dt><dd><strong class="tabular-nums text-base-content"><%= forum.views_count %></strong> <%= t('frm.forums.index.views').downcase %></dd></div>
        </dl>
      </div>

      <div class="last-post max-w-md text-sm lg:w-64">
        <p class="font-medium text-base-content"><%= t('last_post') %></p>
        <% if last_post = forum.last_post_for(current_user) %>
          <p class="mt-1 break-words"><%= link_to last_post.topic.subject, group_forum_topic_url(@group, forum, last_post.topic), class: "inline-flex min-h-11 items-center underline-offset-4 hover:underline" %></p>
          <p class="mt-1 text-base-content/60">
            <%= t('by') %> <%= last_post.user || t('frm.posts.post.deleted_user') %> ·
            <time datetime="<%= last_post.created_at.iso8601 %>"><%= time_ago_in_words(last_post.created_at) %></time>
          </p>
        <% else %>
          <p class="mt-1 text-base-content/60"><%= t('frm.forums.index.none') %></p>
        <% end %>
      </div>
    </div>
  </article>
<% end %>
