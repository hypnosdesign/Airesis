<% @page_title = "#{@forum.title} - #{@group.name}" %>
<% @extend = true %>

<div class="forum">
  <%= render partial: 'frm/forums/head', locals: { forum: @forum } %>
  <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-3xl">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-bold tracking-tight"><%= @forum.title %></h1>
        <span class="badge badge-outline"><%= @forum.visible_outside? ? t('frm.forums.visibility.public') : t('frm.forums.visibility.private') %></span>
      </div>
      <div class="mt-3 text-base-content/70"><%= forem_format(@forum.description) %></div>
    </div>
    <% if can? :create_topic, @forum %>
      <%= link_to new_group_forum_topic_url(@group, @forum), class: "btn btn-primary min-h-11 shrink-0", data: { disable_with: t('loading') } do %>
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <%= t('frm.topic.links.new') %>
      <% end %>
    <% end %>
  </header>

  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-base-content/60"><%= t('frm.forums.show.topic_count', count: @topics.size) %></p>
    <% if can? :moderate, @forum %>
      <%= link_to group_frm_forum_moderator_tools_url(@group, @forum), class: "btn btn-outline min-h-11" do %>
        <i class="fa-solid fa-flag" aria-hidden="true"></i>
        <%= t('frm.forum.moderator_tools') %>
      <% end %>
    <% end %>
  </div>

  <%= forem_pages_widget(@pagy) %>
  <% if @topics.empty? %>
    <div class="rounded-box border border-base-300 bg-base-100 p-6 text-center" role="status">
      <h2 class="text-xl font-semibold"><%= t('frm.topic.none') %></h2>
      <p class="mt-2 text-base-content/70"><%= t('frm.forums.show.empty_description') %></p>
    </div>
  <% else %>
    <div class="topics divide-y divide-base-300 rounded-box border border-base-300 bg-base-100" role="list" aria-label="<%= t('frm.topic.headings.topic') %>">
      <%= render @topics %>
    </div>
  <% end %>
  <%= forem_pages_widget(@pagy) %>
</div>

<%= render partial: '/frm/application/forem_footer' %>
