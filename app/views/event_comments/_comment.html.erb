<article id="event_comment_<%= comment.id %>"
         class="border border-base-content/15 bg-base-100 p-4 sm:p-5"
         <%= 'data-collapsed' if comment.collapsed %>>
  <header class="mb-3 flex items-center gap-3">
    <%= avatar(comment.user, size: 40) %>
    <div class="min-w-0">
      <p class="break-words font-bold">
        <%= link_to_user comment.user, class: 'inline-flex min-h-11 items-center' %>
      </p>
      <p class="text-sm text-base-content/60"><%= time_in_words(comment.created_at) %></p>
    </div>
  </header>
  <div class="prose max-w-[72ch] break-words text-sm">
    <%= simple_format(comment.body) %>
  </div>
  <footer class="mt-4 flex flex-wrap items-center gap-2 border-t border-base-content/10 pt-3 text-sm">
    <% if user_signed_in? %>
      <% if comment.likers.include? current_user %>
        <%= link_to t('pages.event_comments.unlike'), like_event_event_comment_path(@event, comment),
                    class: 'btn btn-ghost btn-sm min-h-11', data: { turbo_method: :post } %>
      <% else %>
        <%= link_to t('pages.event_comments.like'), like_event_event_comment_path(@event, comment),
                    class: 'btn btn-ghost btn-sm min-h-11', data: { turbo_method: :post } %>
      <% end %>
    <% end %>
    <span class="text-base-content/60"><%= t('pages.event_comments.likes_count', count: comment.likes.size) %></span>
    <% if current_user&.id == comment.user_id %>
      <%= link_to t('pages.blog_posts.comment.delete_button'), [@event, comment],
                  data: { turbo_method: :delete, turbo_confirm: t('pages.blog_posts.comment.confirm_delete') },
                  class: 'btn btn-ghost btn-sm min-h-11 text-error sm:ml-auto' %>
    <% end %>
  </footer>
</article>
