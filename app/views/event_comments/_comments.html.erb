<div id="eventComments" class="mt-4 space-y-3">
  <% @event_comments.each do |comment| %>
    <%= render partial: 'event_comments/comment', locals: { comment: comment } %>
  <% end %>
  <% if @event_comments.empty? %>
    <p class="border border-dashed border-base-content/20 bg-base-100 p-5 text-sm text-base-content/65"><%= t('pages.events.show.no_comments') %></p>
  <% end %>
</div>
