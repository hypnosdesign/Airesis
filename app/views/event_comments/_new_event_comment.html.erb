<div id="eventNewComment">
  <% unless user_signed_in? %>
    <p class="text-sm text-base-content/70"><%= t('pages.proposals.show.login_to_comment') %></p>
  <% else %>
    <%= simple_form_for [@event, event_comment] do |f| %>
      <%= f.error_notification %>
      <%= f.input :body,
                  as: :text,
                  label: t('pages.proposals.show.add_comment'),
                  input_html: { rows: 5, maxlength: EventComment::MAX_BODY_LENGTH } %>
      <%= f.submit t('pages.event_comments.new.insert_comment'),
                   data: { disable_with: t('loading') },
                   class: 'btn btn-primary min-h-11' %>
    <% end %>
  <% end %>
</div>
