<% @page_title = t('error.error_500.title') %>

<main class="py-8 sm:py-12">
  <div class="error-shell">
    <div class="flex size-14 items-center justify-center rounded-2xl bg-error/10 text-error">
      <i class="fa-solid fa-screwdriver-wrench text-xl" aria-hidden="true"></i>
    </div>
    <h1 class="mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl"><%= t('error.error_500.title') %></h1>
    <p class="mt-3 max-w-xl text-base leading-relaxed text-base-content/70"><%= t('error.error_500.description') %></p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <%= link_to root_path, class: 'btn btn-primary font-bold' do %>
        <i class="fa-solid fa-house" aria-hidden="true"></i>
        <%= t('pages.errors.home_action', default: 'Go to the homepage') %>
      <% end %>
      <%= link_to open_space_path, class: 'btn btn-outline font-bold' do %>
        <i class="fa-solid fa-globe" aria-hidden="true"></i>
        <%= t('pages.errors.explore_action', default: 'Explore public space') %>
      <% end %>
    </div>
  </div>
</main>
