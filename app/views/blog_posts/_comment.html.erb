<article id="comment<%= comment.id %>" class="blogComment rounded-box bg-base-100 p-4 shadow-sm" data-comment-id="<%= comment.id %>" <%= 'data-collapsed' if comment.collapsed %>>
  <div class="blog-comment-image flex items-center gap-2 mb-2">
    <%= avatar(comment.user, size: 20) %>
    <span class="blogPoster font-semibold">
      <%= link_to_user comment.user %>
    </span>
  </div>
  <div class="blog-comment-content mb-2">
    <%= auto_link(h(comment.body).gsub(/\n/, '<br/>'), html: { target: '_blank' }, sanitize: true) { |text| truncate(text, length: 15) } %>
  </div>
  <div class="blog-comment-footer text-sm text-base-content/60">
    <div title="<%= l comment.created_at %>">
      <%= time_in_words comment.created_at %>
      <% if can? :destroy, comment %>
        <div class="float-right">
          <%= link_to t('pages.blog_posts.comment.delete_button'), [@blog, @blog_post, comment], data: { turbo_method: :delete, turbo_confirm: t('pages.proposals.show.delete_contribute_confirmation') }, class: "deleteCommentLink btn btn-ghost min-h-11 text-error" %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="clear-both"></div>
</article>
