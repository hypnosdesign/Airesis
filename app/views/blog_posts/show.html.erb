<% content_for :html_options do %>
  itemscope itemtype="http://schema.org/Blog"
<% end %>

<%= content_for :head do %>
  <meta property="og:url" content="<%= current_url %>"/>
  <meta property="og:title" content="<%= @blog_post.title %>"/>
  <meta property="og:type" content="article"/>
  <meta property="og:image" content="<%= asset_url('logo120.png') %>"/>
  <meta property="og:site_name" content="<%= ENV['APP_LONG_NAME'] %>"/>
  <meta property="fb:app_id" content="<%= ENV['FACEBOOK_APP_ID'] %>"/>
  <meta property="article:published_time" content="<%= @blog_post.created_at.strftime('%Y/%m/%d') %>">
  <meta property="article:tag" content="<%= @blog_post.tags_list %>">
<% end %>

<%= render layout: "layouts/page_title", locals: { title: @page_title } do %>
  <% if can? :update, @blog_post %>
    <%= link_to (@group ? edit_group_blog_post_path(@group, @blog_post) : edit_blog_blog_post_path(@blog, @blog_post)), class: 'btn min-h-11' do %>
      <i class="fa-solid fa-pencil" aria-hidden="true"></i>
      <%= t('pages.blog_posts.show.edit_button') %>
    <% end %>
    <details class="relative w-full sm:w-auto">
      <summary class="btn btn-error min-h-11 w-full sm:w-auto">
        <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
        <%= t('pages.blog_posts.show.delete_button') %>
      </summary>
      <div class="mt-2 w-full rounded-box border border-base-content/15 bg-base-100 p-4 shadow-lg sm:absolute sm:right-0 sm:z-10 sm:w-72" data-delete-confirmation>
        <p class="mb-3 text-sm"><%= t('pages.blog_posts.show.delete_button_confirm') %></p>
        <%= button_to @blog_url,
                      method: :delete,
                      class: 'btn btn-error min-h-11 w-full',
                      form: { data: { turbo: false } } do %>
          <%= t('pages.blog_posts.show.confirm_delete_button') %>
        <% end %>
      </div>
    </details>
  <% end %>
<% end %>

<div class="blogPost">
  <article class="rounded-box bg-base-100 p-5 shadow-sm sm:p-7">
    <p class="mb-4 text-sm font-semibold text-base-content/70"><%= blog_post_label @blog_post %></p>
    <div class="blogPostBody prose max-w-[72ch] mb-5" itemprop="description">
      <%= @blog_post.body %>
    </div>
    <div class="blogPostFooter">
      <div class="blogPostPostedAt text-sm text-base-content/60">
        <% name = link_to((avatar(@blog_post.user, size: 15, cert: false) + @blog_post.user.fullname), @blog_post.user) %>
        <%= raw t('pages.blog_posts.list_elements.inserted', name: name, date: (l @blog_post.created_at)) %>
        |
        <span class="blogComments">
          <%= link_to t('pages.blog_posts.view.comments', count: @blog_post.blog_comments.count), '#blogPostCommentsContainer', class: 'inline-flex min-h-11 items-center' %>
        </span>
      </div>
      <% if ::Configuration::socialnetwork_active %>
        <div class="post_buttons mt-2">
          <a href="https://twitter.com/share" class="twitter-share-button" data-lang="en" data-text="<%= t('twitter.share.blog_post', app: APP_SHORT_NAME, tags: @blog_post.tags.for_twitter) %>" data-url="<%= blog_blog_post_url(@blog_post.blog, @blog_post) %>">Tweet</a>
          | <div class="fb-like" data-href="<%= @blog_url %>" data-width="450" data-layout="button_count" data-show-faces="true" data-send="true"></div>
        </div>
      <% end %>
    </div>
    <% unless @blog_post.tags.blank? %>
      <div class="blogPostTags mt-2">
        <span class="tag_label font-semibold"><%= t('pages.blog_posts.show.tags_title') %> </span>
        <span class="tags_list"><%= tag_links_for(@blog_post) %></span>
      </div>
    <% end %>
    <% if @blog_post.groups.any? %>
      <section class="mt-6 border-t border-base-content/15 pt-4" aria-labelledby="published-groups-title">
        <h2 id="published-groups-title" class="mb-3 text-lg font-bold"><%= t('pages.blog_posts.published_groups') %></h2>
        <ul class="flex flex-wrap gap-2" role="list">
          <% @blog_post.groups.each do |group| %>
            <li><%= link_to group.name, group_url(group), class: 'btn btn-sm min-h-11' %></li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </article>
</div>

<section class="mt-8" aria-labelledby="blog-comments-title">
  <h2 id="blog-comments-title" class="mb-4 text-2xl font-bold"><%= t('pages.blog_posts.comments_title') %></h2>
  <div id="blogNewComment" class="blogNewComment mb-6 rounded-box bg-base-100 p-5 shadow-sm">
    <%= render partial: 'blog_comments/new_blog_comment', locals: { blog_comment: @blog_comment } %>
  </div>
  <div id="blogPostCommentsContainer">
    <%= render partial: 'blog_posts/comments' %>
  </div>
  <div class="mt-6"><%= pagy_nav(@pagy) if @pagy.pages > 1 %></div>
</section>
