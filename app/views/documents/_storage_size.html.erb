<% current_storage_size = @current_storage_size || @group.actual_storage_size %>
<% percentage = @group.max_storage_size.to_f.positive? ? ((current_storage_size.to_f / @group.max_storage_size.to_f) * 100).round(2) : 0 %>
<div class="rounded-box bg-base-100 p-5 shadow-sm">
  <h2 class="font-bold"><%= t('pages.groups.documents.storage_size') %></h2>
  <div class="text-2xl font-bold"><%= percentage %>%</div>
  <div class="mt-2">
    <progress class="progress progress-primary w-full" value="<%= percentage %>" max="100" aria-label="<%= t('pages.groups.documents.storage_progress', percentage: percentage) %>"></progress>
  </div>
  <ul class="mt-2 text-sm">
    <li>
      <%= t('pages.groups.documents.max_storage_size') %>:
      <b><%= (@group.max_storage_size.to_f / 1024).round(2) %> MB</b>
    </li>
    <li>
      <%= t('pages.groups.documents.current_storage_usage') %>:
      <b><%= (current_storage_size.to_f / 1024).round(2) %> MB</b>
    </li>
  </ul>
</div>
