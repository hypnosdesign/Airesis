<%= simple_form_for [@blog_post.blog, @blog_post, blog_comment] do |f| %>
  <%= f.error_notification %>
  <%= f.input :body, label: t('pages.proposals.show.add_comment'), required: true, input_html: { class: 'blogNewCommentField', rows: 5, maxlength: 10.kilobytes, aria: { describedby: 'blog-comment-help' } } %>
  <p id="blog-comment-help" class="mb-3 text-sm text-base-content/70"><%= t('pages.blog_comments.new.help') %></p>
  <%= f.submit t('pages.blog_comments.new.insert_comment'), data: { disable_with: t('loading') }, class: 'btn btn-primary min-h-11' %>
<% end %>
