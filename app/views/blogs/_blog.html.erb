<li>
  <article class="flex h-full flex-col rounded-box bg-base-100 p-4 shadow-sm">
    <div class="mb-4 flex items-center gap-3">
      <%= image_tag blog.user.user_image_url(96, force_size: false), alt: '', class: 'h-16 w-16 shrink-0 rounded-full object-cover', loading: 'lazy' %>
      <div class="min-w-0 grow">
        <h2 class="text-lg font-bold">
          <%= link_to (blog.title.to_s != '' ? blog.title : 'No title'), blog, title: blog.title %>
        </h2>
        <p class="mt-1 text-sm text-base-content/70"><%= link_to_user blog.user, full_name: true %></p>
      </div>
    </div>
    <div class="border-t border-base-content/10 pt-3 text-sm">
      <p>
        <%= t('pages.blogs.index.blog_subtitle', posts: blog.blog_posts.count, comments: blog.comments.count) %>
      </p>
      <% if can?(:edit, blog) || can?(:destroy, blog) %>
        <div class="mt-3 flex flex-wrap gap-2">
        <% if can? :edit, blog %>
          <%= link_to t('buttons.edit'), edit_blog_path(blog), class: 'btn btn-ghost min-h-11' %>
        <% end %>
        <% if can? :destroy, blog %>
          <%= link_to t('buttons.delete'), blog, data: { turbo_confirm: t('blog.delete.confirm_message', count: blog.blog_posts.count), turbo_method: :delete }, class: 'btn btn-ghost min-h-11 text-error' %>
        <% end %>
        </div>
      <% end %>
    </div>
  </article>
</li>
