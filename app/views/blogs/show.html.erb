<%= content_for :head do %>
  <%= auto_discovery_link_tag(:atom, blog_url(@blog, format: 'atom')) %>
<% end %>

<%= render layout: "layouts/page_title", locals: { title: @blog.title } do %>
  <% if can? :edit, @blog %>
    <%= link_to new_blog_blog_post_path(@blog), class: 'btn btn-primary min-h-11' do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
      <%= t('pages.blog_posts.new_button') %>
    <% end %>
    <%= link_to drafts_blog_blog_posts_path(@blog), class: 'btn min-h-11' do %>
      <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
      <%= t('pages.blog_posts.drafts_button') %>
    <% end %>
    <%= link_to edit_blog_path(@blog), class: 'btn min-h-11' do %>
      <i class="fa-solid fa-pencil" aria-hidden="true"></i>
      <%= t('pages.blogs.show.edit_button') %>
    <% end %>
  <% end %>
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <section aria-label="<%= t('pages.blogs.show.posts') %>">
  <% if @blog_posts.size == 0 && !params[:page] %>
    <div class="blogPost card bg-base-200 p-4">
      <h2 class="text-lg font-bold"><%= t('pages.blogs.show.no_posts') %></h2>
      <p><%= t('pages.blogs.show.no_posts_long') %></p>
    </div>
  <% else %>
    <% if @tag %>
      <h2 class="text-lg mb-2">
        <%= t('pages.blogs.show.tag') %>: <%= @tag %>
      </h2>
    <% end %>
    <div id="blogPostContainer">
      <%= render collection: @blog_posts, partial: 'blog_posts/blog_post' %>
    </div>
  <% end %>
  <div class="mt-6"><%= pagy_nav(@pagy) if @pagy.pages > 1 %></div>
  </section>
  <aside aria-label="<%= t('pages.blogs.show.activity') %>">
    <%= render 'blogs/left_panel' %>
  </aside>
</div>
