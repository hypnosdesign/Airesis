<% @extend = true %>

<%= render layout: 'layouts/page_title', locals: { title: t('pages.blogs.index.find_blog_label') } do %>
  <% if current_user && current_user.blog.nil? %>
    <%= link_to new_blog_path, class: 'btn btn-primary min-h-11' do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
      <%= t('pages.blogs.new.create_button') %>
    <% end %>
  <% end %>
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(16rem,2fr)]">
  <section id="blog_search_form" aria-labelledby="blog-search-title" class="rounded-box bg-base-100 p-5 shadow-sm">
    <h2 id="blog-search-title" class="mb-3 text-xl font-bold"><%= t('pages.blogs.index.search_title') %></h2>
      <%= render 'blogs/search_form' %>
  </section>
  <aside aria-labelledby="blog-tags-title" class="rounded-box bg-base-100 p-5 shadow-sm">
    <h2 id="blog-tags-title" class="mb-3 text-xl font-bold"><%= t('pages.blogs.index.browse_tags') %></h2>
    <div class="flex flex-wrap gap-2" data-tag-cloud>
      <% @tags.each do |tag| %>
        <%= link_to tag.text, blogs_url(tag: tag.text), class: 'badge badge-outline min-h-11 px-3' %>
      <% end %>
    </div>
  </aside>
</div>

<% if @blogs.count > 0 %>
  <h2 class="mb-3 mt-8 text-xl font-bold"><%= t('pages.blogs.index.results_title') %></h2>
  <ul id="blogs_list" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <% @blogs.each do |blog| %>
      <%= render partial: "blog", locals: { blog: blog } %>
    <% end %>
  </ul>
<% else %>
  <section class="mt-8 rounded-box border border-base-content/15 bg-base-100 p-6 text-center" aria-labelledby="blogs-empty-title">
    <i class="fa-regular fa-newspaper mb-3 text-3xl text-base-content/50" aria-hidden="true"></i>
    <h2 id="blogs-empty-title" class="text-xl font-bold"><%= t('pages.blogs.index.no_results') %></h2>
    <p class="mx-auto mt-2 max-w-prose text-base-content/70"><%= t('pages.blogs.index.search_description') %></p>
  </section>
<% end %>

<div class="mt-6"><%= pagy_nav(@pagy) if @pagy.pages > 1 %></div>
