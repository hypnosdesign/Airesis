<% modal = local_assigns.fetch(:modal, false) %>
<% title = @participation_role.persisted? ? t('pages.groups.edit_permissions.edit_role_heading', role: @participation_role.name) : t('pages.groups.edit_permissions.new_role_title') %>
<% if modal %>
  <h2 id="participation-role-dialog-title" class="mb-5 text-2xl font-extrabold"><%= title %></h2>
<% end %>
<%= simple_form_for((@group.present? ? [@group, @participation_role] : @participation_role), html: { data: (modal ? {} : { turbo: false }) }) do |f| %>
  <%= f.input :name %>
  <%= f.input :description, as: :text, input_html: { rows: 5 } %>
  <div class="mt-6 flex flex-wrap gap-3">
    <% if modal %>
      <%= button_tag t('buttons.cancel'), type: 'button', class: 'btn', data: { action: 'click->modal#close' } %>
    <% else %>
      <%= link_to t('buttons.cancel'), group_participation_roles_path(@group), class: 'btn' %>
    <% end %>
    <%= f.button :button, class: 'btn btn-primary' do %>
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      <%= button_name %>
    <% end %>
  </div>
<% end %>
