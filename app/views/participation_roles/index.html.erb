<%= render layout: "layouts/page_title", locals: { title: t('pages.groups.edit_permissions.title') } do %>
  <%= link_to new_group_participation_role_url(@group), data: { turbo_stream: true, disable_with: t('loading') }, class: 'btn btn-primary' do %>
    <i class="fa-solid fa-plus" aria-hidden="true"></i>
    <%= t('pages.groups.edit_permissions.new_role') %>
  <% end %>
<% end %>
<p class="mb-6 max-w-3xl text-base-content/70"><%= t('pages.groups.edit_permissions.description') %></p>
<div id="roles_panel_container">
  <%= render partial: 'groups/roles_panel' %>
</div>
<div id="participation_role_modal"></div>
<% content_for :left_panel do %>
  <%= render 'groups/administration_panel' %>
<% end %>
