<% @extend = true %>

<header class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
  <div>
    <h1 class="mb-2 text-2xl font-extrabold lg:text-3xl"><%= t('pages.groups.participations.list_participations') %></h1>
    <p class="text-sm text-base-content/65"><%= @group.name %> · <%= t('pages.groups.index.results_count', count: @pagy.count, default: "%{count} results") %></p>
  </div>
  <%= link_to group_group_participations_path(@group, format: :csv), class: 'btn btn-outline min-h-11' do %>
    <i class="fa-solid fa-file-csv" aria-hidden="true"></i>
    <%= t('pages.groups.show.print_all_participants') %>
  <% end %>
</header>

<div class="mb-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <% if can? :create, SearchParticipant %>
    <section class="border-2 border-base-content/15 bg-base-100 p-4 sm:p-5" aria-labelledby="participant-search-title">
      <h2 id="participant-search-title" class="mb-4 text-lg font-extrabold"><%= t('pages.groups.participations.search') %></h2>
      <%= form_with url: group_group_participations_path(@group), method: :get, scope: :search_participant, class: 'space-y-4' do |f| %>
        <div class="form-control">
          <%= f.label :keywords, class: 'label label-text font-semibold' %>
          <%= f.search_field :keywords, value: params.dig(:search_participant, :keywords), class: 'input input-bordered min-h-11 w-full', autocomplete: 'off' %>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="form-control">
            <%= f.label :role_id, class: 'label label-text font-semibold' %>
            <%= f.select :role_id,
                         options_from_collection_for_select([OpenStruct.new(id: ParticipationRole.admin.id, name: @group.admin_title.presence || t('pages.groups.default_admin_title'))] + @group.participation_roles, :id, :name, params.dig(:search_participant, :role_id)),
                         { include_blank: t('pages.groups.participations.anything') },
                         class: 'select select-bordered min-h-11 w-full' %>
          </div>
          <div class="form-control">
            <%= f.label :status_id, class: 'label label-text font-semibold' %>
            <%= f.select :status_id,
                         options_for_select(GroupParticipationRequest.group_participation_request_status_ids.except(:voting), params.dig(:search_participant, :status_id)),
                         { include_blank: t('pages.groups.participations.anything') },
                         class: 'select select-bordered min-h-11 w-full' %>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= f.submit t('pages.groups.participations.filter'), class: 'btn btn-primary min-h-11', data: { disable_with: t('loading') } %>
          <% if params[:search_participant].present? %>
            <%= link_to t('buttons.cancel'), group_group_participations_path(@group), class: 'btn btn-ghost min-h-11' %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if can? :update, @group %>
    <% receiver_ids = @unscoped_group_participations.filter_map { |item| item.user_id if item.respond_to?(:user_id) } %>
    <% removable_ids = @unscoped_group_participations.filter_map { |item| item.id if item.is_a?(GroupParticipation) && item.user_id != current_user.id } %>
    <section class="border-2 border-base-content/15 bg-base-100 p-4 sm:p-5" aria-labelledby="participant-operations-title">
      <h2 id="participant-operations-title" class="mb-2 text-lg font-extrabold"><%= t('pages.groups.participations.operations_on_user') %></h2>
      <p class="mb-4 text-sm text-base-content/60"><%= t('pages.groups.participations.operations_hint', default: 'These operations apply to the filtered results.') %></p>
      <div class="flex flex-wrap gap-2">
        <button type="button"
                class="btn btn-outline min-h-11"
                aria-haspopup="dialog"
                aria-controls="email_modal"
                <%= 'disabled' if receiver_ids.empty? %>
                data-controller="dialog-trigger"
                data-dialog-trigger-dialog-id-value="email_modal"
                data-action="click->dialog-trigger#open">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          <%= t('pages.groups.participations.send_email') %>
        </button>

        <%= form_with url: destroy_all_group_group_participations_path(@group), method: :post, scope: :destroy do |f| %>
          <%= f.hidden_field :ids, value: removable_ids.join(',') %>
          <%= f.button class: 'btn btn-outline min-h-11 text-error',
                       disabled: removable_ids.empty?,
                       data: { turbo_confirm: t('pages.groups.edit_permissions.confirm_delete_1', count: removable_ids.size), disable_with: t('loading') } do %>
            <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
            <%= t('pages.groups.participations.remove_all') %>
          <% end %>
        <% end %>
      </div>

      <dialog id="email_modal"
              class="modal"
              aria-labelledby="email-modal-title"
              data-controller="modal"
              data-modal-open-on-connect-value="false"
              data-modal-remove-on-close-value="false">
        <div class="modal-box border-2 border-base-content/20">
          <button type="button" class="btn btn-ghost btn-circle btn-sm absolute right-2 top-2" aria-label="<%= t('buttons.close', default: 'Close') %>" data-action="click->modal#close">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
          <h2 id="email-modal-title" class="mb-4 pr-10 text-xl font-extrabold"><%= t('pages.users.send_message.massive_email') %></h2>
          <%= form_with scope: :message, url: send_email_group_group_participations_path(@group), method: :post, class: 'space-y-4' do |f| %>
            <div class="form-control">
              <%= f.label :subject, t('pages.users.send_message.subject_label'), class: 'label label-text font-semibold' %>
              <%= f.text_field :subject, required: true, class: 'input input-bordered min-h-11 w-full' %>
            </div>
            <div class="form-control">
              <%= f.label :body, t('pages.users.send_message.body_label'), class: 'label label-text font-semibold' %>
              <%= f.text_area :body, rows: 8, required: true, class: 'textarea textarea-bordered w-full' %>
            </div>
            <%= f.hidden_field :receiver_ids, value: receiver_ids.join(',') %>
            <div class="flex flex-wrap justify-end gap-2">
              <button type="button" class="btn btn-ghost min-h-11" data-action="click->modal#close"><%= t('buttons.cancel') %></button>
              <%= f.submit t('buttons.send'), class: 'btn btn-primary min-h-11', data: { disable_with: t('sending') } %>
            </div>
          <% end %>
        </div>
        <form method="dialog" class="modal-backdrop" data-action="click->modal#backdropClose">
          <button aria-label="<%= t('buttons.close', default: 'Close') %>"><%= t('buttons.close', default: 'Close') %></button>
        </form>
      </dialog>
    </section>
  <% end %>
</div>

<section aria-labelledby="participant-results-title">
  <h2 id="participant-results-title" class="sr-only"><%= t('pages.groups.index.results', default: 'Results') %></h2>
  <ul id="results_container" class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3" role="list">
    <%= render partial: 'group_participation_results' %>
  </ul>
  <% unless @group_participations.any? %>
    <div class="border-2 border-base-content/15 bg-base-100 p-8 text-center">
      <i class="fa-solid fa-user-group mb-3 text-4xl text-base-content/20" aria-hidden="true"></i>
      <p class="font-bold"><%= t('pages.groups.participations.no_results', default: 'No members match these filters.') %></p>
    </div>
  <% end %>
</section>

<%= pagy_nav(@pagy) if @pagy.pages > 1 %>
