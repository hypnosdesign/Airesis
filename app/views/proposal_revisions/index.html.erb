<% @page_title = t('pages.proposal_histories.index.title', title: @proposal.title) %>

<%= render layout: 'layouts/page_title', locals: { title: @page_title } do %>
  <%= link_to t('pages.proposal_histories.index.back_to_proposal'),
              @group ? group_proposal_path(@group, @proposal) : proposal_path(@proposal),
              class: 'btn btn-outline min-h-11' %>
<% end %>

<%= render 'proposal_revisions/history_explorer' %>

<% content_for :left_panel do %>
  <%= render 'proposals/left_panel' %>
<% end %>
