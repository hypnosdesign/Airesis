<aside id="primary-navigation"
       class="sidebar-nav relative flex min-h-full flex-col bg-base-100 border-r-2 border-base-content/15 w-0 overflow-hidden is-drawer-open:w-64 lg:is-drawer-close:w-[4.5rem] lg:is-drawer-open:w-64 lg:overflow-visible transition-all duration-200"
       aria-label="<%= t('pages.sidebar.primary_navigation', default: 'Primary navigation') %>"
       tabindex="-1"
       data-sidebar-drawer-target="dialog">

  <button type="button"
          class="btn btn-ghost btn-circle absolute right-2 top-2 z-10 size-11 min-h-11 lg:hidden"
          aria-label="<%= t('pages.header.close_navigation', default: 'Close navigation') %>"
          data-sidebar-drawer-target="close"
          data-action="sidebar-drawer#close">
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>

  <%# Logo %>
  <%= link_to root_path,
      class: "flex items-center gap-3 px-4 min-h-16 border-b-2 border-base-content/10 is-drawer-close:justify-center is-drawer-close:px-0",
      aria: { label: t('pages.sidebar.product_home', app: APP_SHORT_NAME, default: '%{app} homepage') } do %>
    <div class="w-9 h-9 bg-primary flex items-center justify-center shrink-0">
      <i class="fa-solid fa-landmark text-primary-content text-base"></i>
    </div>
    <span class="font-extrabold text-lg tracking-tight is-drawer-close:hidden"><%= APP_SHORT_NAME %></span>
  <% end %>

  <% dashboard_active = current_page?(home_path) || current_page?(root_path) %>
  <% proposals_active = controller_name == 'proposals' %>
  <% groups_active = controller_name == 'groups' %>
  <% events_active = controller_name == 'events' %>
  <% public_active = current_page?(open_space_path) %>
  <% settings_active = %w[users alerts notifications searches].include?(controller_name) || (controller_name == 'registrations' && action_name == 'edit') %>

  <%# Nav %>
  <div class="px-2 pt-5">
    <p class="text-[9px] font-bold text-base-content/30 uppercase tracking-widest mb-2 px-3 is-drawer-close:hidden"><%= t('pages.sidebar.overview', default: 'Panoramica') %></p>
    <ul class="menu w-full gap-0.5">
      <li>
        <%= link_to home_path, class: "#{dashboard_active ? 'bg-primary text-primary-content font-semibold' : 'text-base-content/75 hover:bg-base-200 hover:text-base-content'} is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": "Dashboard", "aria-label": "Dashboard", aria: { current: (dashboard_active ? 'page' : nil) } do %>
          <i class="fa-solid fa-gauge w-6 text-center text-lg"></i>
          <span class="is-drawer-close:hidden">Dashboard</span>
        <% end %>
      </li>
      <li>
        <%= link_to proposals_path, class: "#{proposals_active ? 'bg-primary text-primary-content font-semibold' : 'text-base-content/75 hover:bg-base-200 hover:text-base-content'} is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.sidebar.proposals', default: 'Proposals'), "aria-label": t('pages.sidebar.proposals', default: 'Proposals'), aria: { current: (proposals_active ? 'page' : nil) } do %>
          <i class="fa-solid fa-file-lines w-6 text-center text-lg"></i>
          <span class="is-drawer-close:hidden"><%= t('pages.sidebar.proposals', default: 'Proposte') %></span>
        <% end %>
      </li>
      <% if current_user && current_user.groups.any? %>
        <li data-controller="sidebar-menu"
            data-sidebar-menu-open-value="<%= @group.present? ? 'true' : 'false' %>">
          <button data-action="click->sidebar-menu#toggle"
                  aria-label="<%= t('pages.sidebar.groups', default: 'Groups') %>"
                  class="w-full <%= groups_active ? 'bg-primary text-primary-content font-semibold' : 'text-base-content/75 hover:bg-base-200 hover:text-base-content' %> flex items-center px-3 py-2 text-sm gap-2 is-drawer-close:justify-center is-drawer-close:tooltip is-drawer-close:tooltip-right"
                  aria-current="<%= 'page' if groups_active %>"
                  data-tip="<%= t('pages.sidebar.groups', default: 'Gruppi') %>">
            <i class="fa-solid fa-users w-6 text-center text-lg shrink-0"></i>
            <span class="is-drawer-close:hidden flex-1 text-left"><%= t('pages.sidebar.groups', default: 'Gruppi') %></span>
            <i class="fa-solid fa-chevron-right text-xs is-drawer-close:hidden transition-transform duration-200"
               data-sidebar-menu-target="arrow"></i>
          </button>
          <ul data-sidebar-menu-target="submenu"
              style="max-height: 0; overflow: hidden; transition: max-height 0.25s ease;"
              class="is-drawer-close:hidden pl-8 mt-0.5 space-y-0.5">
            <% current_user.groups.limit(6).each do |g| %>
              <li>
                <%= link_to g.name, group_path(g),
                    class: "block px-3 py-1.5 text-sm #{@group&.id == g.id ? 'text-primary font-semibold' : 'text-base-content/75 hover:bg-base-200 hover:text-base-content'} truncate" %>
              </li>
            <% end %>
            <% if current_user.groups.count > 6 %>
              <li>
                <%= link_to t('pages.sidebar.all_groups', default: 'Tutti i gruppi →'), groups_path,
                    class: 'block px-3 py-1.5 text-xs text-primary font-bold hover:underline' %>
              </li>
            <% end %>
          </ul>
        </li>
      <% else %>
        <li>
          <%= link_to groups_path, class: "#{groups_active ? 'bg-primary text-primary-content font-semibold' : 'text-base-content/75 hover:bg-base-200 hover:text-base-content'} is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.sidebar.groups', default: 'Groups'), "aria-label": t('pages.sidebar.groups', default: 'Groups'), aria: { current: (groups_active ? 'page' : nil) } do %>
            <i class="fa-solid fa-users w-6 text-center text-lg"></i>
            <span class="is-drawer-close:hidden"><%= t('pages.sidebar.groups', default: 'Gruppi') %></span>
          <% end %>
        </li>
      <% end %>
      <li>
        <%= link_to events_path, class: "#{events_active ? 'bg-primary text-primary-content font-semibold' : 'text-base-content/75 hover:bg-base-200 hover:text-base-content'} is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.sidebar.events', default: 'Events'), "aria-label": t('pages.sidebar.events', default: 'Events'), aria: { current: (events_active ? 'page' : nil) } do %>
          <i class="fa-solid fa-calendar w-6 text-center text-lg"></i>
          <span class="is-drawer-close:hidden"><%= t('pages.sidebar.events', default: 'Eventi') %></span>
        <% end %>
      </li>
      <li>
        <%= link_to open_space_path, class: "#{public_active ? 'bg-primary text-primary-content font-semibold' : 'text-base-content/75 hover:bg-base-200 hover:text-base-content'} is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('open_space'), "aria-label": t('open_space'), aria: { current: (public_active ? 'page' : nil) } do %>
          <i class="fa-solid fa-earth-americas w-6 text-center text-lg"></i>
          <span class="is-drawer-close:hidden"><%= t('open_space') %></span>
        <% end %>
      </li>
    </ul>
  </div>

  <% if current_user %>
    <%# Azioni rapide %>
    <div class="px-2 pt-5">
      <p class="text-[9px] font-bold text-base-content/30 uppercase tracking-widest mb-2 px-3 is-drawer-close:hidden"><%= t('pages.sidebar.quick_actions', default: 'Crea') %></p>
      <ul class="menu w-full gap-0.5">
        <li>
          <%= link_to new_proposal_path, class: "text-base-content/75 hover:bg-base-200 hover:text-base-content is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.sidebar.new_proposal', default: 'New proposal'), "aria-label": t('pages.sidebar.new_proposal', default: 'New proposal') do %>
            <i class="fa-solid fa-plus w-6 text-center text-lg"></i>
            <span class="is-drawer-close:hidden"><%= t('pages.sidebar.new_proposal', default: 'Nuova proposta') %></span>
          <% end %>
        </li>
        <li>
          <%= link_to new_group_path, class: "text-base-content/75 hover:bg-base-200 hover:text-base-content is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.sidebar.new_group', default: 'New group'), "aria-label": t('pages.sidebar.new_group', default: 'New group') do %>
            <i class="fa-solid fa-user-group w-6 text-center text-lg"></i>
            <span class="is-drawer-close:hidden"><%= t('pages.sidebar.new_group', default: 'Nuovo gruppo') %></span>
          <% end %>
        </li>
        <li>
          <%= link_to new_event_path, class: "text-base-content/75 hover:bg-base-200 hover:text-base-content is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.sidebar.new_event', default: 'New event'), "aria-label": t('pages.sidebar.new_event', default: 'New event') do %>
            <i class="fa-solid fa-calendar-plus w-6 text-center text-lg"></i>
            <span class="is-drawer-close:hidden"><%= t('pages.sidebar.new_event', default: 'Nuovo evento') %></span>
          <% end %>
        </li>
      </ul>
    </div>
  <% end %>

  <%# Bottom %>
  <div class="mt-auto px-2 pb-4 pt-4 border-t-2 border-base-content/10">
    <ul class="menu w-full gap-0.5">
      <% if current_user %>
        <li>
          <%= link_to user_path(current_user), class: "#{settings_active ? 'bg-primary text-primary-content font-semibold' : 'text-base-content/75 hover:bg-base-200'} is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.sidebar.settings', default: 'Settings'), "aria-label": t('pages.sidebar.settings', default: 'Settings'), aria: { current: (settings_active ? 'page' : nil) } do %>
            <i class="fa-solid fa-gear w-6 text-center text-lg"></i>
            <span class="is-drawer-close:hidden"><%= t('pages.sidebar.settings', default: 'Impostazioni') %></span>
          <% end %>
        </li>
        <li>
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "text-error hover:bg-error/10 is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.header.menu.logout'), "aria-label": t('pages.header.menu.logout') do %>
            <i class="fa-solid fa-right-from-bracket w-6 text-center text-lg"></i>
            <span class="is-drawer-close:hidden"><%= t('pages.header.menu.logout') %></span>
          <% end %>
        </li>
      <% else %>
        <li>
          <%= link_to new_user_session_path, class: "text-base-content/75 hover:bg-base-200 is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.header.login'), "aria-label": t('pages.header.login') do %>
            <i class="fa-solid fa-right-to-bracket w-6 text-center text-lg"></i>
            <span class="is-drawer-close:hidden"><%= t('pages.header.login') %></span>
          <% end %>
        </li>
        <li>
          <%= link_to new_registration_path(:user), class: "text-primary hover:bg-primary/10 is-drawer-close:tooltip is-drawer-close:tooltip-right is-drawer-close:justify-center", "data-tip": t('pages.header.menu.registration_button'), "aria-label": t('pages.header.menu.registration_button') do %>
            <i class="fa-solid fa-user-plus w-6 text-center text-lg"></i>
            <span class="is-drawer-close:hidden"><%= t('pages.header.menu.registration_button') %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</aside>
