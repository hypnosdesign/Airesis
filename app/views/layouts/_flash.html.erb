<div id="flash-container" class="mb-5 space-y-3">
  <% flash.each do |key, value| %>
    <% alert_class = case key
                     when 'info' then 'alert-info'
                     when 'notice' then 'alert-success'
                     when 'warn' then 'alert-warning'
                     else 'alert-error'
                     end %>
    <div class="alert <%= alert_class %> shadow-brutal cursor-pointer"
         role="<%= %w[error alert].include?(key.to_s) ? 'alert' : 'status' %>"
         data-controller="flash"
         data-flash-type-value="<%= key %>"
         data-flash-auto-dismiss-value="5000"
         data-action="click->flash#dismiss">
      <span><%= raw value %></span>
    </div>
  <% end %>

  <% Announcement.current(cookies.signed[:hidden_announcement_ids]).each do |announcement| %>
    <div id="announcement<%= announcement.id %>"
         class="alert alert-info shadow-brutal"
         role="status"
         data-controller="flash"
         data-flash-auto-dismiss-value="0">
      <span><%= sanitize announcement.message, tags: %w[strong em a], attributes: %w[href rel] %></span>
      <%= link_to t('pages.announcements.dismiss'), hide_announcement_path(announcement), class: "btn btn-sm min-h-11", data: { turbo_method: :post }, aria: { label: t('pages.announcements.dismiss_label') } %>
    </div>
  <% end %>
</div>
