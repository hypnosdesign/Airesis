<footer class="bg-base-200 border-t border-base-300 py-4 mt-auto">
  <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-2 text-sm text-base-content">
    <span class="text-base-content/85">
      <%= APP_SHORT_NAME %> v<%= AIRESIS_VERSION %> &middot;&nbsp;
      <a class="link link-hover" href="https://github.com/airesis/airesis" target="_blank" rel="noopener noreferrer"><%= t('pages.footer.built_on_airesis', default: 'Built on Airesis') %></a>
    </span>
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-base-content/85">
      <%= link_to t('terms_of_service'), terms_path, class: 'inline-flex min-h-11 min-w-11 items-center justify-center px-1 link link-hover' %>
      <%= link_to t('privacy_policy'), privacy_path, class: 'inline-flex min-h-11 min-w-11 items-center justify-center px-1 link link-hover' %>
      <%= link_to t('cookie_policy'), cookie_law_path, class: 'inline-flex min-h-11 min-w-11 items-center justify-center px-1 link link-hover' %>
      <%= link_to t('pages.home.index.whatis'), edemocracy_path, class: 'inline-flex min-h-11 min-w-11 items-center justify-center px-1 link link-hover' %>
      <span class="feedback_space"></span>
    </div>
  </div>
</footer>

<%= render 'layouts/languages' %>
