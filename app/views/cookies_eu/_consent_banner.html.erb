<% unless cookies['cookie_eu_consented'] == 'true' %>
  <aside class="relative z-20 border-t border-base-content/20 bg-base-300 px-4 py-3"
         data-controller="cookie-consent"
         role="region"
         aria-label="<%= t('cookies_eu.banner_label', default: 'Cookie notice') %>">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-3xl text-sm leading-relaxed text-base-content/80">
        <%= t('cookies_eu.cookies_text') %>
        <% if defined?(link) && link.present? %>
          <a href="<%= link %>" class="link link-primary"><%= t('cookies_eu.learn_more') %></a>
        <% end %>
      </p>
      <button class="btn btn-primary btn-sm shrink-0"
              data-action="click->cookie-consent#accept">
        <%= t('cookies_eu.ok') %>
      </button>
    </div>
  </aside>
<% end %>
