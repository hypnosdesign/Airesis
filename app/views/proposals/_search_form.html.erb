<% if params[:search].present? %>
  <div class="mb-3 flex items-center justify-between gap-2 border border-primary/30 bg-primary/10 px-3 py-2 text-sm" role="status">
    <span><%= t('pages.proposals.index.active_search', default: 'Searching for:') %> <strong><%= params[:search] %></strong></span>
    <%= link_to current_url(search: nil, or: nil), class: 'btn btn-ghost btn-sm', aria: { label: t('pages.proposals.index.clear_search', default: 'Clear proposal search') } do %>
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    <% end %>
  </div>
<% end %>

<%= form_with url: request.path, method: :get, class: 'space-y-3' do %>
  <% %i[state view order category type group_area_id interest_border l].each do |filter| %>
    <%= hidden_field_tag filter, params[filter] if params[filter].present? %>
  <% end %>
  <div>
    <%= label_tag :search, t('pages.proposals.index.search_label', default: 'Search proposals'), class: 'mb-1 block text-sm font-semibold' %>
    <%= text_field_tag :search, params[:search], placeholder: t('pages.proposals.index.search_placeholder'), class: 'input input-bordered w-full' %>
  </div>
  <label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm" for="or">
    <%= check_box_tag :or, 'or', params[:or].present?, class: 'checkbox checkbox-primary' %>
    <span><%= t('pages.proposals.index.search_words') %></span>
  </label>
  <%= submit_tag t('buttons.search'), class: 'btn btn-primary w-full' %>
<% end %>
