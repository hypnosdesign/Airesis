<% if params[:view] == SearchProposal::ORDER_BY_END %>
  <span class="order_option sel inline-flex min-h-11 items-center gap-2 border-2 border-primary bg-primary px-3 py-2 font-bold text-primary-content">
    <%= link_to t('pages.proposals.tabs.most_urgent'), current_url(action: :index, view: SearchProposal::ORDER_BY_END, order: params[:order] == 'a' ? nil : 'a'), title: t('pages.proposals.index.sort_debate_end', default: 'Sort by debate end'), aria: { current: 'page' }, data: { disable_with: t('loading') } %>
    <%= order_arrow %>
  </span>
<% else %>
  <span class="order_option inline-flex min-h-11 items-center border-2 border-base-content/20 px-3 py-2 hover:border-primary hover:text-primary">
    <%= link_to t('pages.proposals.tabs.most_urgent'), current_url(action: :index, view: SearchProposal::ORDER_BY_END), title: t('pages.proposals.index.sort_debate_end', default: 'Sort by debate end'), data: { disable_with: t('loading') } %>
  </span>
<% end %>
