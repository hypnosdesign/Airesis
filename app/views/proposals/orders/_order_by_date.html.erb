<% if !params[:view] || (params[:view] == SearchProposal::ORDER_BY_DATE) %>
  <span class="order_option sel inline-flex min-h-11 items-center gap-2 border-2 border-primary bg-primary px-3 py-2 font-bold text-primary-content">
    <%= link_to t('pages.proposals.tabs.last_inserted'), current_url(action: :index, view: SearchProposal::ORDER_BY_DATE, order: (params[:order] == 'a') ? nil : 'a'), title: t('pages.proposals.index.sort_updated', default: 'Sort by last update'), aria: { current: 'page' }, data: { disable_with: t('loading') } %>
    <%= order_arrow %>
  </span>
<% else %>
  <span class="order_option inline-flex min-h-11 items-center border-2 border-base-content/20 px-3 py-2 hover:border-primary hover:text-primary">
    <%= link_to t('pages.proposals.tabs.last_inserted'), current_url(action: :index, view: SearchProposal::ORDER_BY_DATE), title: t('pages.proposals.index.sort_updated', default: 'Sort by last update'), data: { disable_with: t('loading') } %>
  </span>
<% end %>
