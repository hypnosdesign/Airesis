<% @extend = true %>
<%= render layout: 'layouts/page_title', locals: { title: @tag } do %><% end %>
<nav aria-label="<%= t('pages.tags.show.on_this_page') %>" class="mb-6 flex flex-wrap gap-2 border-b border-base-content/15 pb-4">
  <%= link_to t('pages.tags.proposals_tab'), '#proposals', class: 'btn btn-ghost min-h-11' %>
  <%= link_to t('pages.tags.posts_tab'), '#posts', class: 'btn btn-ghost min-h-11' %>
  <%= link_to t('pages.tags.groups_tab'), '#groups', class: 'btn btn-ghost min-h-11' %>
</nav>
<div class="space-y-10">
  <section id="proposals" aria-labelledby="tag-proposals-title" class="scroll-mt-24">
    <h2 id="tag-proposals-title" class="mb-4 text-2xl font-bold"><%= t('pages.tags.list_proposals_with_tag') %></h2>
    <% if @proposals.size == 0 %>
      <div class="Proposal">
        <p><%= t('pages.tags.no_proposals_with_tag') %></p>
      </div>
    <% else %>
      <ul class="grid grid-cols-1 xl:grid-cols-2 gap-4">
        <% @proposals.each do |proposal| %>
          <%= render 'proposals/proposal_list_element', proposal_list_element_for_mustache(proposal) %>
        <% end %>
      </ul>
    <% end %>
  </section>
  <section id="posts" aria-labelledby="tag-posts-title" class="scroll-mt-24">
    <h2 id="tag-posts-title" class="mb-4 text-2xl font-bold"><%= t('pages.tags.list_posts_with_tag') %></h2>
    <% if @blog_posts.size == 0 %>
      <div class="blogPost">
        <p><%= t('pages.tags.no_posts_with_tag') %></p>
      </div>
    <% else %>
      <% @blog_posts.each do |blog_post| %>
        <div>
          <%= render 'blog_posts/blog_post', blog_post: blog_post %>
        </div>
      <% end %>
    <% end %>
  </section>
  <section id="groups" aria-labelledby="tag-groups-title" class="scroll-mt-24">
    <h2 id="tag-groups-title" class="mb-4 text-2xl font-bold"><%= t('pages.tags.list_groups_with_tags') %></h2>
    <% if @groups.size == 0 %>
      <p><%= t('pages.tags.no_groups_with_tag') %></p>
    <% else %>
      <ul class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-4">
        <%= render collection: @groups, partial: 'groups/group_tag', as: 'group' %>
      </ul>
    <% end %>
  </section>
</div>
<% content_for :left_panel do %>
  <div class="card bg-base-200 p-4">
    <h2 class="mb-3 font-bold"><%= t('pages.tags.show.related_title') %></h2>
    <div class="flex flex-wrap gap-2">
      <% @similars.each do |tag| %>
        <%= link_to tag.text, tag_path(tag.text), class: 'badge badge-outline min-h-8 px-3' %>
      <% end %>
    </div>
  </div>
<% end %>
