<%= turbo_stream.replace "quorum_modal" do %>
  <dialog id="quorum_modal" data-controller="modal" class="modal" aria-labelledby="quorum-form-title">
    <div class="modal-box shadow-brutal border-2 border-base-content max-w-3xl">
      <%= render 'quorums/form', button_name: t('buttons.create'), modal: true %>
    </div>
    <form method="dialog" class="modal-backdrop" data-action="click->modal#backdropClose">
      <button aria-label="<%= t('buttons.close') %>"><%= t('buttons.close') %></button>
    </form>
  </dialog>
<% end %>
