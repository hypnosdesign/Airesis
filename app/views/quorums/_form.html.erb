<% modal = local_assigns.fetch(:modal, false) %>
<% debate_average = @group_participations_count.positive? ? (@group.statistic.valutations * 100 / @group_participations_count).round(2) : 0 %>
<% vote_average = @vote_participants_count.positive? ? (@group.statistic.vote_valutations * 100 / @vote_participants_count).round(2) : 0 %>

<h2 id="quorum-form-title" class="text-xl font-bold"><%= @page_title %></h2>

<% if %w[edit update].include?(params[:action]) %>
  <p class="mt-3 border-2 border-info/30 bg-info/10 p-3"><%= t('pages.groups.edit_quorums.edit_quorum_warning') %></p>
<% end %>

<%= simple_form_for [@group, @quorum], validate: true,
                    html: { class: 'mt-5 space-y-5', data: {
                      controller: 'quorum-form',
                      quorum_form_participants_total_value: @group_participations_count,
                      quorum_form_vote_participants_total_value: @vote_participants_count
                    } } do |form| %>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= form.input :name, input_html: { class: 'input input-bordered min-h-11' } %>
    <%= form.input :description, as: :text, input_html: { rows: 3, class: 'textarea textarea-bordered min-h-24' } %>
  </div>

  <div class="grid gap-5 lg:grid-cols-2">
    <fieldset class="border-2 border-base-content/15 p-4">
      <legend class="px-2 font-bold"><%= t('pages.groups.edit_quorums.debate', default: 'Debate') %></legend>
      <div class="mt-2 grid grid-cols-3 gap-3">
        <%= form.input :days_m, input_html: { min: 0, class: 'input input-bordered min-h-11' } %>
        <%= form.input :hours_m, input_html: { min: 0, max: 23, class: 'input input-bordered min-h-11' } %>
        <%= form.input :minutes_m, input_html: { min: 0, max: 55, step: 5, class: 'input input-bordered min-h-11' } %>
      </div>
      <%= form.input :percentage, as: :integer, input_html: {
        min: 0, max: 100, class: 'input input-bordered min-h-11',
        data: { quorum_form_target: 'participants', action: 'input->quorum-form#updateParticipants' }
      } %>
      <p class="text-sm text-base-content/70">
        <%= t('pages.groups.edit_quorums.new_quorum.advanced_participation_description',
              current_number: '<strong data-quorum-form-target="participantsOutput">0</strong>'.html_safe,
              total_number: @group_participations_count, average: debate_average).html_safe %>
      </p>
      <%= form.input :good_score, as: :integer, input_html: { min: 1, max: 100, class: 'input input-bordered min-h-11' } %>
    </fieldset>

    <fieldset class="border-2 border-base-content/15 p-4">
      <legend class="px-2 font-bold"><%= t('pages.groups.edit_quorums.votation', default: 'Voting') %></legend>
      <%= form.input :vote_percentage, as: :integer, input_html: {
        min: 0, max: 100, class: 'input input-bordered min-h-11',
        data: { quorum_form_target: 'voteParticipants', action: 'input->quorum-form#updateVoteParticipants' }
      } %>
      <p class="text-sm text-base-content/70">
        <%= t('pages.groups.edit_quorums.new_quorum.advanced_participation_description',
              current_number: '<strong data-quorum-form-target="voteParticipantsOutput">0</strong>'.html_safe,
              total_number: @vote_participants_count, average: vote_average).html_safe %>
      </p>
      <%= form.input :vote_good_score, as: :integer, input_html: { min: 0, max: 100, class: 'input input-bordered min-h-11' } %>
    </fieldset>
  </div>

  <div class="flex flex-wrap gap-2">
    <% if modal %>
      <button type="button" class="btn btn-outline min-h-11" data-action="modal#close"><%= t('buttons.cancel') %></button>
    <% else %>
      <%= link_to t('buttons.cancel'), group_quorums_path(@group), class: 'btn btn-outline min-h-11' %>
    <% end %>
    <%= form.button :button, class: 'btn btn-primary min-h-11' do %>
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      <%= button_name %>
    <% end %>
  </div>
<% end %>
