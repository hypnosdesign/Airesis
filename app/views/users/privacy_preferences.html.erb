<% @page_title = t('pages.user.privacy') %>

<div class="space-y-6">
  <header>
    <p class="text-xs font-bold uppercase tracking-widest text-[var(--ui-link-color)] mb-2"><%= t('pages.users.left_panel.title') %></p>
    <h1 class="text-3xl font-extrabold"><%= @page_title %></h1>
    <p class="mt-2 max-w-2xl text-sm text-base-content/75"><%= t('pages.users.privacy_preferences.description', default: 'Manage account behavior, security, language and connected sign-in providers.') %></p>
  </header>

  <section class="bg-base-100 border-2 border-base-content/15 p-5 sm:p-6" aria-labelledby="preference-options-title">
    <h2 id="preference-options-title" class="text-lg font-bold mb-2"><%= t('pages.users.privacy_preferences.options') %></h2>
    <div class="flex flex-col gap-2">
      <label class="tooltips flex min-h-11 items-center gap-3">
        <%= check_box :user, :show_tooltips, value: current_user.show_tooltips, class: 'toggle toggle-primary', onclick: "return change_show_tooltips(this);" %>
        <%= t('pages.users.privacy_preferences.tooltips') %>
      </label>
      <% if ::Configuration::socialnetwork_active %>
        <label class="show_urls flex min-h-11 items-center gap-3">
          <%= check_box :user, :show_urls, value: current_user.show_urls, class: 'toggle toggle-primary', onclick: "return change_show_urls(this);" %>
          <%= t('pages.users.privacy_preferences.show_urls') %>
        </label>
      <% end %>
      <% if ::Configuration::user_messages %>
        <label class="messages flex min-h-11 items-center gap-3">
          <%= check_box :user, :receive_messages, value: current_user.receive_messages, class: 'toggle toggle-primary', onclick: "return change_receive_messages(this);" %>
          <%= t('pages.users.privacy_preferences.private_messages') %>
        </label>
      <% end %>
      <% if ::Configuration.rotp %>
        <h2 class="text-lg font-bold mt-4 mb-2"><%= t('pages.users.privacy_preferences.rotp_title') %></h2>
        <label class="rotp flex min-h-11 items-center gap-3">
          <%= check_box :user, :rotp_enabled, value: current_user.rotp_enabled, class: 'toggle toggle-primary', onclick: "return change_rotp_enabled(this);" %>
          <%= t('pages.users.privacy_preferences.rotp') %>
        </label>
        <div id="rotp_container">
          <%= render 'users/rotp_code' %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="bg-base-100 border-2 border-base-content/15 p-5 sm:p-6" aria-labelledby="mail-language-title">
    <h2 id="mail-language-title" class="text-lg font-bold mb-2"><%= t('pages.users.privacy_preferences.mail_language') %></h2>
    <div class="email_locale mb-4">
      <label for="locale" class="sr-only"><%= t('pages.users.privacy_preferences.mail_language') %></label>
      <%= select_tag 'locale', options_for_select(SysLocale.all.collect { |p| [I18n.t("db.sys_locales.#{p.key}.description"), p.id] }, selected: current_user.sys_locale_id), class: 'select select-bordered min-h-11 w-full max-w-md' %>
    </div>
    <h2 id="time-zone-title" class="text-lg font-bold mb-2"><%= t('pages.users.privacy_preferences.time_zone') %></h2>
    <div class="time_zone">
      <label for="time_zone" class="sr-only"><%= t('pages.users.privacy_preferences.time_zone') %></label>
      <%= select_tag 'time_zone', options_for_select(ActiveSupport::TimeZone.all.collect { |p| [p, p.name] }, selected: current_user.time_zone), class: 'select select-bordered min-h-11 w-full max-w-md' %>
    </div>
  </section>

  <section class="bg-base-100 border-2 border-base-content/15 p-5 sm:p-6" aria-labelledby="connected-accounts-title">
    <% if ::Configuration::socialnetwork_active %>
      <h2 id="connected-accounts-title" class="text-lg font-bold mb-2"><%= t('pages.users.privacy_preferences.join_accounts') %></h2>
      <p class="mb-4 text-sm text-base-content/75"><%= sanitize t('pages.users.privacy_preferences.join_accounts_description', app_short_name: APP_SHORT_NAME) %></p>
      <% authentications = current_user.authentications %>
      <% alreadyproviders = current_user.authentications.pluck(:provider) %>
      <% if alreadyproviders.size == 3 %>
        <p><%= t('pages.users.privacy_preferences.joined_all') %></p>
      <% end %>
      <div class="providers flex flex-col gap-2 mb-4">
        <% unless alreadyproviders.include? Authentication::FACEBOOK %>
          <%= link_to omniauth_authorize_path(:user, :facebook), class: 'btn min-h-11' do %>
            <i class="fa-brands fa-facebook fa-social"></i>
            <%= t('pages.users.privacy_preferences.join_facebook') %>
          <% end %>
        <% end %>
        <% unless alreadyproviders.include? Authentication::GOOGLE %>
          <%= link_to omniauth_authorize_path(:user, :google_oauth2), class: 'btn min-h-11' do %>
            <i class="fa-brands fa-google fa-social"></i>
            <%= t('pages.users.privacy_preferences.join_google') %>
          <% end %>
        <% end %>
        <% unless alreadyproviders.include? Authentication::TWITTER %>
          <%= link_to omniauth_authorize_path(:user, :twitter), class: 'btn min-h-11' do %>
            <i class="fa-brands fa-twitter fa-social"></i>
            <%= t('pages.users.privacy_preferences.join_twitter') %>
          <% end %>
        <% end %>
      </div>
      <% if alreadyproviders.size > 0 %>
        <h2 class="text-lg font-bold mb-2"><%= t('pages.users.privacy_preferences.providers_list') %>:</h2>
        <% authentications.each do |authentication| %>
          <div class="flex items-center gap-2 mb-2">
            <% if authentication.provider == Authentication::FACEBOOK %>
              <i class="fa-brands fa-facebook fa-social"></i> Facebook
            <% elsif authentication.provider == Authentication::GOOGLE %>
              <i class="fa-brands fa-google fa-social"></i> Google
            <% elsif authentication.provider == Authentication::TWITTER %>
              <i class="fa-brands fa-twitter fa-social"></i> Twitter
            <% end %>
            <% if @user.email %>
              <%= link_to t('buttons.detach'), [@user, authentication], data: { turbo_method: :delete, turbo_confirm: t('confirm_detach') }, class: 'btn btn-error min-h-11' %>
            <% else %>
              <%= link_to t('buttons.detach'), '#', data: { detach_disabled: true }, class: 'btn btn-disabled min-h-11' %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <h2 id="connected-accounts-title" class="text-lg font-bold"><%= t('pages.users.privacy_preferences.join_accounts') %></h2>
      <p class="mt-2 text-sm text-base-content/75"><%= t('pages.users.privacy_preferences.providers_unavailable', default: 'External sign-in providers are not enabled on this instance.') %></p>
    <% end %>
  </section>
</div>

<% if can?(:change_rotp_enabled, current_user) %>
  <% _rotp_js = "var confirm_msg = el.checked ? \"#{j t('pages.users.privacy_preferences.rotp_confirm_enable')}\" : '#{j t('pages.users.privacy_preferences.rotp_confirm_disable')}'; if (!confirm(confirm_msg)) { return false; } postPreference('/users/change_rotp_enabled', { active: el.checked ? 'true' : 'false' }); " %>
<% else %>
  <% _rotp_js = "alert('Per abilitare il Token di sicurezza devi inserire un\\'indirizzo email valido'); return false; " %>
<% end %>

<script type="text/javascript">
  document.querySelectorAll('a[data-detach-disabled]').forEach(function(el) {
    el.addEventListener('click', function(e) { alert('<%= j raw t('alert_detach') %>'); e.preventDefault(); });
  });
  function postPreference(url, data) {
    var csrf = document.querySelector('meta[name="csrf-token"]');
    fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf ? csrf.content : '', 'Accept': 'text/vnd.turbo-stream.html' },
      body: new URLSearchParams(data).toString()
    }).then(function(r) { return r.text(); }).then(function(html) { Turbo.renderStreamMessage(html); });
  }
  function change_show_tooltips(el) { postPreference("/users/change_show_tooltips", { active: el.checked ? "true" : "false" }); }
  function change_show_urls(el) { postPreference("/users/change_show_urls", { active: el.checked ? "true" : "false" }); }
  function change_receive_messages(el) { postPreference("/users/change_receive_messages", { active: el.checked ? "true" : "false" }); }
  function change_rotp_enabled(el) {
    <%= raw _rotp_js %>
  }
  var localeEl = document.getElementById('locale');
  if (localeEl) localeEl.addEventListener('change', function() { postPreference("/users/change_locale", { locale: this.value }); });
  var tzEl = document.getElementById('time_zone');
  if (tzEl) tzEl.addEventListener('change', function() { postPreference("/users/change_time_zone", { time_zone: this.value }); });
</script>

<% content_for :left_panel do %>
  <% if current_user %>
    <%= render partial: 'users/preferences_panel' %>
  <% end %>
<% end %>
