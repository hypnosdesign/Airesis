<% @page_title = t('.title') %>

<div class="space-y-6">
  <header>
    <p class="text-xs font-bold uppercase tracking-widest text-[var(--ui-link-color)] mb-2"><%= t('pages.users.left_panel.title') %></p>
    <h1 class="text-3xl font-extrabold"><%= @page_title %></h1>
    <p class="mt-2 max-w-2xl text-sm text-base-content/75"><%= t('users.statistics.description', default: 'A private summary of your participation and proposal activity.') %></p>
  </header>

<% statistic_groups = [
  [t('.contributions_group'), [
    [t('.integrated_count'), @integrated_count],
    [t('.spam_count'), @spam_count],
    [t('.noisy_count'), @noisy_count],
    [t('.total_count'), @contributes_count],
    [t('.total_comments_count'), @comments_count]
  ]],
  [t('.proposals_group'), [
    [t('.proposals_editor'), @proposals_count],
    [t('.proposals_voted'), @voted_count],
    [t('.average_rank_voted_proposals'), @voted_rank],
    [t('.proposals_accepted_count'), @accepted_count],
    [t('.proposals_abandonend_count'), @abandoned_count]
  ]]
] %>

<div class="grid gap-4 lg:grid-cols-2">
  <section class="bg-base-100 border-2 border-base-content/15 p-5 sm:p-6 lg:col-span-2" aria-labelledby="account-activity-title">
    <h2 id="account-activity-title" class="text-lg font-bold"><%= t('.account_group') %></h2>
    <dl class="mt-4 flex flex-wrap items-baseline justify-between gap-2 border-t border-base-content/15 pt-4">
      <dt class="font-semibold"><%= t('.last_login') %></dt>
      <dd class="text-sm text-base-content/75">
        <% if @user.last_sign_in_at.present? %>
          <time datetime="<%= @user.last_sign_in_at.iso8601 %>"><%= l(@user.last_sign_in_at, format: :long) %></time>
        <% else %>
          <%= t('.not_available') %>
        <% end %>
      </dd>
    </dl>
  </section>

  <% statistic_groups.each_with_index do |(title, statistics), index| %>
    <section class="bg-base-100 border-2 border-base-content/15 p-5 sm:p-6" aria-labelledby="activity-group-<%= index %>">
      <h2 id="activity-group-<%= index %>" class="text-lg font-bold"><%= title %></h2>
      <dl class="mt-4 divide-y divide-base-content/10 border-t border-base-content/15">
        <% statistics.each do |label, value| %>
          <div class="flex items-start justify-between gap-4 py-3">
            <dt class="text-sm text-base-content/75"><%= label %></dt>
            <dd class="shrink-0 text-lg font-extrabold"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </section>
  <% end %>

  <section class="bg-base-100 border-2 border-base-content/15 p-5 sm:p-6 lg:col-span-2" aria-labelledby="quality-scores-title">
    <h2 id="quality-scores-title" class="text-lg font-bold"><%= t('.quality_group') %></h2>
    <dl class="mt-4 grid gap-5 sm:grid-cols-2">
      <% [[t('.good_writer'), @good_writer_score], [t('.good_proposals_writer'), @good_proposals_writer_score]].each do |label, score| %>
        <div>
          <div class="mb-2 flex items-center justify-between gap-4">
            <dt class="text-sm font-semibold"><%= label %></dt>
            <dd class="font-extrabold"><%= score %>%</dd>
          </div>
          <progress class="progress progress-primary h-3 w-full" value="<%= score %>" max="100" aria-label="<%= label %>: <%= score %>%"></progress>
        </div>
      <% end %>
    </dl>
  </section>
</div>

<% if @user == current_user && @user.user_votes.count > 0 %>
  <div class="card bg-base-200 p-4">
    <h2 class="text-xl font-bold mb-2"><%= t('pages.users.show.votations_title') %></h2>
    <table id="votations_table" class="table">
      <thead>
        <tr>
          <th><%= t('pages.users.show.proposal_column') %></th>
          <th><%= t('pages.users.show.votation_date_column') %></th>
          <th class="hidden">vote_sortable</th>
          <th><%= t('pages.users.show.vote_column') %></th>
        </tr>
      </thead>
      <tbody>
        <% @user.user_votes.includes(:vote_type, proposal: :groups).each do |vote| %>
          <tr>
            <td><%= vote.proposal ? (link_to_proposal vote.proposal) : '' %></td>
            <td><%= l vote.created_at %></td>
            <td class="hidden"><%= vote.created_at.to_i %></td>
            <td><%= vote.vote_type ? vote.vote_type.description : t('pages.users.show.secret_vote') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

  </div>
<% end %>
</div>

<% content_for :left_panel do %>
  <% if current_user %>
    <%= render partial: 'users/preferences_panel' %>
  <% end %>
<% end %>
