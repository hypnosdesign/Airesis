<div class="bg-base-100 border-2 border-base-content/15 p-6 mb-6">
  <div class="flex items-center gap-3 mb-6">
    <div class="bg-primary/10 text-primary p-2">
      <i class="fa-solid fa-id-card"></i>
    </div>
    <div>
      <h2 class="font-bold text-lg">
        <%= t('pages.users.show.profile_info') %>
        <%= t('pages.users.show.profile_info_unconfirmed') unless @user.confirmed? %>
      </h2>
      <p class="text-xs text-base-content/75"><%= t('pages.users.show.profile_info_desc', default: 'Personal details and contact information.') %></p>
    </div>
    <% if @user == current_user %>
      <button type="button" class="btn btn-outline min-h-11 font-bold ml-auto" aria-haspopup="dialog" aria-controls="img_modal" onclick="document.getElementById('img_modal').showModal()">
        <i class="fa-solid fa-camera mr-1" aria-hidden="true"></i> <%= t('pages.users.show.edit_image') %>
      </button>
    <% end %>
  </div>

  <div class="divide-y divide-base-content/10">
    <% name_row_tag = current_user == @user ? :button : :div %>
    <%= content_tag name_row_tag, id: 'name_profile', type: (name_row_tag == :button ? 'button' : nil), class: 'w-full profile_element flex items-center gap-4 min-h-12 py-3 px-2 hover:bg-base-200 text-left', aria: (name_row_tag == :button ? { haspopup: 'dialog', controls: 'name_modal' } : {}), onclick: (name_row_tag == :button ? "document.getElementById('name_modal').showModal()" : nil) do %>
      <span class="text-[11px] text-base-content/75 font-bold uppercase w-28 shrink-0"><%= t('pages.users.show.name_label') %></span>
      <span class="font-medium"><%= h @user.name %></span>
      <% if current_user == @user %>
        <i class="fa-solid fa-pen-to-square text-base-content/20 ml-auto text-sm"></i>
      <% end %>
    <% end %>

    <% surname_row_tag = current_user == @user ? :button : :div %>
    <%= content_tag surname_row_tag, id: 'surname_profile', type: (surname_row_tag == :button ? 'button' : nil), class: 'w-full profile_element flex items-center gap-4 min-h-12 py-3 px-2 hover:bg-base-200 text-left', aria: (surname_row_tag == :button ? { haspopup: 'dialog', controls: 'surname_modal' } : {}), onclick: (surname_row_tag == :button ? "document.getElementById('surname_modal').showModal()" : nil) do %>
      <span class="text-[11px] text-base-content/75 font-bold uppercase w-28 shrink-0"><%= t('pages.users.show.surname_label') %></span>
      <span class="font-medium"><%= h @user.surname %></span>
      <% if current_user == @user %>
        <i class="fa-solid fa-pen-to-square text-base-content/20 ml-auto text-sm"></i>
      <% end %>
    <% end %>

    <% if current_user == @user %>
      <button id="email_profile" type="button" class="w-full profile_element flex items-center gap-4 min-h-12 py-3 px-2 hover:bg-base-200 text-left" aria-haspopup="dialog" aria-controls="email_modal" onclick="document.getElementById('email_modal').showModal()">
        <span class="text-[11px] text-base-content/75 font-bold uppercase w-28 shrink-0"><%= t('pages.users.show.email_label') %></span>
        <span class="font-medium">
          <%= @user.email %>
          <% if @user.unconfirmed_email %>
            <span class="badge badge-sm badge-warning font-bold ml-2"><%= @user.unconfirmed_email %> - <%= t('pages.users.show.to_be_confirmed') %></span>
          <% end %>
        </span>
        <i class="fa-solid fa-pen-to-square text-base-content/20 ml-auto text-sm"></i>
      </button>

      <button id="password_profile" type="button" class="w-full profile_element flex items-center gap-4 min-h-12 py-3 px-2 hover:bg-base-200 text-left" aria-haspopup="dialog" aria-controls="password_modal" onclick="document.getElementById('password_modal').showModal()">
        <span class="text-[11px] text-base-content/75 font-bold uppercase w-28 shrink-0"><%= t('pages.users.show.password_label') %></span>
        <span class="font-medium">*****</span>
        <i class="fa-solid fa-pen-to-square text-base-content/20 ml-auto text-sm"></i>
      </button>
    <% end %>

    <% if @user.show_urls && ::Configuration::socialnetwork_active %>
      <% if @user.has_provider?(Authentication::FACEBOOK) %>
        <div id="facebook_profile" class="profile_element_no_click flex items-center gap-4 py-3 px-2">
          <span class="text-[11px] text-base-content/75 font-bold uppercase w-28 shrink-0"><%= t('pages.users.show.facebook_url_label') %></span>
          <span class="font-medium">
            <%= link_to @user.facebook_page_url, @user.facebook_page_url, target: '_blank', rel: 'noopener noreferrer', class: 'link link-primary' if @user.facebook_page_url.present? %>
          </span>
        </div>
      <% end %>
      <% if @user.has_provider?(Authentication::GOOGLE) && @user.google_page_url.present? %>
        <div id="google_profile" class="profile_element_no_click flex items-center gap-4 py-3 px-2">
          <span class="text-[11px] text-base-content/75 font-bold uppercase w-28 shrink-0"><%= t('pages.users.show.google_url_label') %></span>
          <span class="font-medium">
            <%= link_to(@user.google_page_url, @user.google_page_url, target: '_blank', rel: 'author noopener noreferrer', class: 'link link-primary') %>
          </span>
        </div>
      <% end %>
      <% if @user.has_provider?(Authentication::TWITTER) && @user.twitter_page_url.present? %>
        <div id="twitter_profile" class="profile_element_no_click flex items-center gap-4 py-3 px-2">
          <span class="text-[11px] text-base-content/75 font-bold uppercase w-28 shrink-0"><%= t('pages.users.show.twitter_url') %></span>
          <span class="font-medium">
            <%= link_to @user.twitter_page_url, @user.twitter_page_url, target: '_blank', rel: 'noopener noreferrer', class: 'link link-primary' %>
          </span>
        </div>
      <% end %>
    <% end %>

    <div id="confirmed_at_profile" class="profile_element_no_click flex items-center gap-4 py-3 px-2">
      <span class="text-[11px] text-base-content/75 font-bold uppercase w-28 shrink-0"><%= t('pages.users.show.registered_from') %></span>
      <span class="font-medium"><%= l(@user.confirmed? ? @user.confirmed_at : @user.created_at) %></span>
    </div>
  </div>
</div>

<% if current_user == @user %>
  <dialog id="img_modal" class="modal" aria-labelledby="img-modal-title" data-controller="modal" data-modal-open-on-connect-value="false" data-modal-remove-on-close-value="false">
    <div class="modal-box">
      <%= simple_form_for @user do |f| %>
        <div class="flex flex-wrap">
          <div class="w-full lg:w-1/2">
            <h2 id="img-modal-title" class="text-lg font-bold mb-2"><%= t('pages.users.show.load_image') %></h2>
            <div class="alert alert-info mb-4">
              <p><%= t('pages.users.show.max_file_size') %></p>
            </div>
            <%= f.input :avatar, required: true, input_html: { accepted: 'image/jpeg,image/png', data: { fv_trigger: 'change', fv_file: true, fv_file_maxsize: UPLOAD_LIMIT_IMAGES } } %>
            <button type="button" class="btn min-h-11" data-action="modal#close" data-modal-target="initialFocus"><%= t('buttons.cancel') %></button>
            <%= f.submit t('buttons.save'), class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
      <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="<%= t('buttons.close') %>">&times;</button></form>
    </div>
  </dialog>

  <script>
    <% if params[:insert_email] %>
      document.getElementById('email_modal').showModal();
    <% end %>
  </script>
<% end %>
