<% @extend = true %>
<% @meta_description = CGI::escapeHTML(strip_tags @group.description) %>

<% content_for :head do %>
  <meta content="<%= current_url %>" property="og:url">
  <meta content="<%= ENV['APP_LONG_NAME'] %>" property="og:site_name">
  <meta content="<%= ENV['FACEBOOK_APP_ID'] %>" property="fb:app_id">
  <meta content="<%= @group.name %>" property="og:title">
  <meta content="airesis:group" property="og:type">
  <meta content="<%= @group.image.attached? ? url_for(@group.image) : asset_url('gruppo-anonimo.png') %>" property="og:image">
  <%= auto_discovery_link_tag(:atom, group_url(@group, format: 'atom')) %>
<% end %>

<% if can? :view_data, @group %>
  <%# Hero banner %>
  <div class="bg-primary text-primary-content p-6 lg:p-8 mb-6 border-2 border-base-content/15 relative overflow-hidden">
    <div class="relative z-10 max-w-xl">
      <h1 class="text-2xl lg:text-3xl font-extrabold leading-tight mb-2"><%= @group.name %></h1>
      <% if @group.interest_border.present? %>
        <p class="text-primary-content/60 text-sm">
          <i class="fa-solid fa-location-dot mr-1"></i> <%= @group.interest_border.territory.description %>
        </p>
      <% end %>
    </div>
    <i class="fa-solid fa-people-group absolute right-6 lg:right-12 top-1/2 -translate-y-1/2 text-[7rem] lg:text-[9rem] text-primary-content/[0.06] hidden md:block"></i>
  </div>

  <%# Stats row %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-base-100 p-4 flex items-center gap-4 border-2 border-base-content/15">
      <div class="w-10 h-10 flex items-center justify-center bg-primary/10 text-primary">
        <i class="fa-solid fa-users"></i>
      </div>
      <div>
        <p class="text-lg font-extrabold"><%= @group.group_participations_count %></p>
        <p class="text-xs font-medium text-base-content/70"><%= t('pages.groups.index.participants_number', default: 'Members') %></p>
      </div>
    </div>
    <div class="bg-base-100 p-4 flex items-center gap-4 border-2 border-base-content/15">
      <div class="w-10 h-10 flex items-center justify-center bg-secondary/10 text-secondary">
        <i class="fa-solid fa-file-lines"></i>
      </div>
      <div>
        <p class="text-lg font-extrabold"><%= @group.proposals_count %></p>
        <p class="text-xs font-medium text-base-content/70"><%= t('pages.groups.index.proposals_number', default: 'Proposals') %></p>
      </div>
    </div>
    <div class="bg-base-100 p-4 flex items-center gap-4 border-2 border-base-content/15">
      <div class="w-10 h-10 flex items-center justify-center bg-accent/10 text-accent">
        <i class="fa-solid fa-calendar"></i>
      </div>
      <div>
        <p class="text-lg font-extrabold"><%= @next_events_count %></p>
        <p class="text-xs font-medium text-base-content/70"><%= t('pages.groups.index.events_number', default: 'Events') %></p>
      </div>
    </div>
    <div class="bg-base-100 p-4 flex items-center gap-4 border-2 border-base-content/15">
      <div class="w-10 h-10 flex items-center justify-center bg-info/10 text-info">
        <i class="fa-solid fa-comments"></i>
      </div>
      <div>
        <p class="text-lg font-extrabold"><%= @pagy.count %></p>
        <p class="text-xs font-medium text-base-content/70"><%= t('pages.groups.show.blog_posts', default: 'Blog posts') %></p>
      </div>
    </div>
  </div>

  <%# Main content %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
      <% if params[:action] == 'by_year_and_month' %>
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <div class="w-8 h-8 flex items-center justify-center bg-primary/10 text-primary">
            <i class="fa-solid fa-calendar-days text-sm"></i>
          </div>
          <div>
            <h2 class="font-bold text-sm"><%= t('pages.groups.archives.page_title', year: params[:year], month: month_long(params[:month]), default: 'Archive for %{month} %{year}') %></h2>
          </div>
        </div>
      <% else %>
        <div class="bg-base-100 border-2 border-base-content/15 p-6 mb-4">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 flex items-center justify-center bg-primary/10 text-primary">
              <i class="fa-solid fa-circle-info text-sm"></i>
            </div>
              <h2 class="font-bold text-sm"><%= t('activerecord.attributes.group.description', default: 'Descrizione') %></h2>
          </div>
          <div class="prose max-w-none text-sm"><%= @group.description %></div>
        </div>
      <% end %>

      <%# Blog posts section %>
      <div class="bg-base-100 border-2 border-base-content/15 p-6 mb-4">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 flex items-center justify-center bg-secondary/10 text-secondary">
            <i class="fa-solid fa-newspaper text-sm"></i>
          </div>
          <h2 class="font-bold text-sm">Blog</h2>
          <% if can? :post_to, @group %>
            <%= link_to new_group_blog_post_path(@group), class: 'btn btn-primary btn-sm ml-auto min-h-11' do %>
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
              <%= t('pages.groups.show.post_button') %>
            <% end %>
          <% end %>
        </div>
        <div id="posts_container">
          <% if @group_posts.any? %>
            <%= render collection: @group_posts, partial: 'blog_posts/group_blog_post', as: 'post_publishing' %>
          <% else %>
            <p class="text-sm text-base-content/70"><%= t('pages.groups.show.no_blogs_yet') %></p>
          <% end %>
        </div>

        <% if @pagy.pages > 1 %>
          <div id="loading_results" class="post_results mt-4">
            <span class="text-xs text-primary font-bold hover:underline cursor-pointer"><%= t('pages.blogs.show.previous_posts') %></span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Sidebar portlets %>
    <aside class="space-y-4" aria-label="<%= t('pages.groups.show.community', default: 'Group community') %>">
      <div id="participants_container">
        <%= render partial: 'groups/participants_panel' %>
      </div>

      <% unless @group.disable_participation_requests %>
        <div id="participation_requests_container" class="participation_requests_container">
          <%= render partial: 'groups/participation_requests_panel' %>
        </div>
      <% end %>

      <%# Group activity — donut chart %>
      <div class="bg-base-100 border-2 border-base-content/15">
        <div class="p-4 border-b-2 border-base-content/15 flex items-center gap-3">
          <div class="bg-primary/10 text-primary w-8 h-8 flex items-center justify-center">
            <i class="fa-solid fa-chart-pie text-sm"></i>
          </div>
          <h2 class="font-bold text-sm"><%= t('pages.groups.show.activity', default: 'Activity') %></h2>
        </div>
        <div class="p-2">
          <% group_chart_data = {
            series: [@group.group_participations_count, @group.proposals_count, @next_events_count],
            labels: [
              t('pages.groups.index.participants_number', default: 'Membri'),
              t('pages.groups.index.proposals_number', default: 'Proposte'),
              t('pages.groups.index.events_number', default: 'Eventi')
            ],
            colors: ['#6366f1', '#10b981', '#f59e0b']
          } %>
          <div data-controller="chart"
               data-chart-type-value="donut"
               data-chart-data-value="<%= group_chart_data.to_json %>">
          </div>
        </div>
      </div>

      <% if can? :view_proposal, @group %>
        <%= render partial: "groups/portlets/proposals", layout: "layouts/portlet" %>
      <% end %>
      <%= render partial: "groups/portlets/topics", layout: "layouts/portlet" %>
      <%= render partial: "groups/portlets/events", layout: "layouts/portlet" %>
    </aside>
  </div>
<% end %>

<%= render 'rules_panel' %>

<div id="quorum_modal"></div>
<div id="quorum_help_modal"></div>
<div id="permissions_list_modal"></div>
<div id="area_role_modal"></div>
<div id="participation_role_modal"></div>
<div id="group_area_modal"></div>
<div id="mod_modal"></div>
