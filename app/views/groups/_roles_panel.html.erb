<div class="space-y-3">
  <% @participation_roles.each_with_index do |role, idx| %>
    <details class="border border-base-content/15 bg-base-100" id="role_<%= role.id %>" <%= 'open' if idx == 0 %>>
      <summary class="flex min-h-14 cursor-pointer flex-wrap items-center gap-2 px-4 py-3 font-extrabold">
        <span class="min-w-0 flex-1 break-words"><%= role.name %></span>
        <% if role.id == @group.participation_role_id %>
          <span class="badge badge-primary"><%= t('pages.groups.edit_permissions.default_badge') %></span>
        <% end %>
        <span class="badge badge-ghost whitespace-nowrap"><%= t('pages.groups.edit_permissions.members_count', count: role.group_participations.count) %></span>
      </summary>
      <div class="border-t border-base-content/10 px-4 py-5">
        <div class="mb-5 flex flex-wrap gap-2 sm:justify-end">
          <%= link_to edit_group_participation_role_url(@group, role), class: 'btn btn-sm' do %>
            <i class="fa-solid fa-pencil" aria-hidden="true"></i>
            <%= t('buttons.edit') %>
          <% end %>
          <% if can? :destroy, role %>
            <%= link_to group_participation_role_url(@group, role), data: { turbo_method: :delete, turbo_confirm: t('pages.groups.edit_permissions.confirm_role_deletion') }, class: 'btn btn-sm btn-ghost text-error' do %>
              <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
              <%= t('buttons.delete') %>
            <% end %>
          <% else %>
            <span class="inline-flex min-h-8 items-center text-sm text-base-content/60"><%= t('pages.groups.edit_permissions.default_protected') %></span>
          <% end %>
        </div>
        <p class="mb-5 max-w-3xl text-sm text-base-content/70"><%= role.description %></p>
        <%= simple_form_for [@group, role], html: { id: "role_permissions_#{role.id}" } do |f| %>
          <input type="hidden" name="no_refresh" value="1">
          <% permission_groups = {
               t('pages.groups.edit_permissions.proposal_permissions') => %i[view_proposals participate_proposals vote_proposals insert_proposals support_proposals choose_date_proposals],
               t('pages.groups.edit_permissions.community_permissions') => %i[create_events write_to_wall accept_participation_requests],
               t('pages.groups.edit_permissions.document_permissions') => %i[view_documents manage_documents]
             } %>
          <div class="grid gap-6 lg:grid-cols-2">
            <% permission_groups.each do |legend, actions| %>
              <fieldset>
                <legend class="mb-3 font-extrabold"><%= legend %></legend>
                <% actions.each do |action| %>
                  <% input_id = "role_#{role.id}_#{action}" %>
                  <label for="<%= input_id %>" class="flex min-h-11 cursor-pointer items-start gap-3 py-2">
                    <%= f.check_box action, id: input_id, class: 'checkbox checkbox-primary mt-0.5 shrink-0' %>
                    <span class="min-w-0 flex-1 break-words leading-6"><%= t("db.group_actions.#{action}.description") %></span>
                  </label>
                <% end %>
              </fieldset>
            <% end %>
          </div>
          <%= f.submit t('pages.groups.edit_permissions.save_permissions'), class: 'btn btn-primary mt-4' %>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
