<% @extend = true %>
<% @page_title = t('pages.groups.index.title') %>

<header class="mb-6 flex flex-col gap-4 border-2 border-base-content/15 bg-primary p-6 text-primary-content lg:flex-row lg:items-end lg:justify-between lg:p-8">
  <div class="max-w-2xl">
    <h1 class="mb-2 text-2xl font-extrabold leading-tight lg:text-3xl"><%= t('pages.groups.index.find_group_label') %></h1>
    <p class="text-sm text-primary-content/75"><%= t('pages.groups.index.title') %></p>
  </div>
  <% if !current_user || can?(:create, Group) %>
    <%= link_to new_group_path, class: 'btn min-h-11 border-0 bg-primary-content text-primary hover:bg-primary-content/90' do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
      <%= t('pages.groups.index.create_group_button') %>
    <% end %>
  <% end %>
</header>

<%# Search & Tags %>
<div class="mb-8 grid grid-cols-1 gap-6 <%= 'lg:grid-cols-2' if @tags.present? %>">
  <div id="group_search_form">
    <div class="bg-base-100 border-2 border-base-content/15 p-4">
      <div class="mb-4 flex items-center gap-3">
        <div class="w-8 h-8 flex items-center justify-center bg-primary/10 text-primary">
          <i class="fa-solid fa-magnifying-glass text-sm"></i>
        </div>
        <h2 class="font-bold text-sm"><%= t('buttons.search', default: 'Search') %></h2>
      </div>
      <%= render 'groups/search_form' %>
    </div>
  </div>
  <% if @tags.present? %>
  <div class="hidden lg:block">
    <div class="bg-base-100 border-2 border-base-content/15 p-4" data-tag-cloud="">
      <div class="mb-4 flex items-center gap-3">
        <div class="w-8 h-8 flex items-center justify-center bg-secondary/10 text-secondary">
          <i class="fa-solid fa-tags text-sm"></i>
        </div>
        <h2 class="font-bold text-sm">Tags</h2>
      </div>
      <div class="flex flex-wrap gap-1">
        <% @tags.each do |tag| %>
          <%= link_to tag.text, groups_url(tag: tag.text), rel: tag.groups_count, class: 'badge badge-primary badge-sm font-bold' %>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>

<div class="mb-4 flex items-center justify-between gap-4">
  <h2 class="text-lg font-extrabold"><%= t('pages.groups.index.results', default: 'Available groups') %></h2>
  <p class="text-sm text-base-content/60" aria-live="polite"><%= t('pages.groups.index.results_count', count: @pagy.count, default: "%{count} results") %></p>
</div>

<% if @groups.any? %>
  <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4" id="groups_list" role="list">
    <%= render partial: "group_tag", collection: @groups, as: :group %>
  </ul>
<% else %>
  <div class="bg-base-100 border-2 border-base-content/15 p-8 text-center">
    <i class="fa-solid fa-people-group text-4xl text-base-content/20 mb-3"></i>
    <h2 class="text-lg font-bold text-base-content/60"><%= t('pages.groups.index.search_description') %></h2>
  </div>
<% end %>

<div id="more_groups_container">
  <%= render partial: 'more_groups' %>
</div>
