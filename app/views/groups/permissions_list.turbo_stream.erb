<%= turbo_stream.replace "permissions_list_modal" do %>
  <dialog id="permissions_list_modal" data-controller="modal" class="modal" aria-labelledby="permissions-modal-title">
    <div class="modal-box max-w-3xl border-2 border-base-content/20">
      <button type="button" class="btn btn-ghost btn-circle btn-sm absolute right-2 top-2" aria-label="<%= t('buttons.close', default: 'Close') %>" data-action="click->modal#close">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
      <h2 id="permissions-modal-title" class="mb-4 pr-10 text-xl font-extrabold"><%= t('pages.groups.show.list_permissions.title') %></h2>
      <%= render "permissions_list_panel", heading_level: 3 %>
      <div class="modal-action">
        <button type="button" class="btn min-h-11" data-action="click->modal#close"><%= t('buttons.close', default: 'Close') %></button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop" data-action="click->modal#backdropClose">
      <button aria-label="<%= t('buttons.close', default: 'Close') %>"><%= t('buttons.close', default: 'Close') %></button>
    </form>
  </dialog>
<% end %>
