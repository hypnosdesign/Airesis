<% heading_level = local_assigns.fetch(:heading_level, 2) %>
<% render_permission_list = lambda do |title, actions, tone| %>
  <section class="border border-base-content/10 p-4">
    <%= content_tag "h#{heading_level}", class: 'mb-3 flex items-center gap-2 font-extrabold text-base-content' do %>
      <i class="fa-solid <%= tone %> <%= tone == 'text-success' ? 'fa-circle-check' : 'fa-circle-xmark' %>" aria-hidden="true"></i>
      <%= title %>
    <% end %>
    <% if actions.any? %>
      <ul class="list-disc space-y-2 pl-5 text-sm">
        <% actions.each do |action| %>
          <li><%= t("db.group_actions.#{action}.description") %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-base-content/60"><%= t('pages.users.show.no_permissions', default: 'No permissions in this section.') %></p>
    <% end %>
  </section>
<% end %>

<% if @group.portavoce.include? current_user %>
  <div class="space-y-4">
    <p class="font-semibold"><%= t('pages.users.show.admin_permissions') %></p>
    <% render_permission_list.call(t('pages.users.show.what_can_i_do'), GroupAction::LIST, 'text-success') %>
  </div>
<% else %>
  <% permitted_actions = GroupAction::LIST.select { |action| @participation_role[action] } %>
  <% denied_actions = GroupAction::LIST.reject { |action| @participation_role[action] } %>

  <% if @group.enable_areas && current_user.scoped_areas(@group).any? %>
    <div role="tablist" class="tabs tabs-bordered">
      <input type="radio" name="perm_tabs" role="tab" class="tab min-h-11" aria-label="<%= t('pages.users.show.group_level_permission_title') %>" checked>
      <div role="tabpanel" class="tab-content space-y-4 py-4">
        <% render_permission_list.call(t('pages.users.show.what_can_i_do'), permitted_actions, 'text-success') %>
        <% render_permission_list.call(t('pages.users.show.what_i_cant_do'), denied_actions, 'text-error') %>
      </div>
      <% current_user.scoped_areas(@group).each do |area| %>
        <% area_role = area.area_participations.find_by(user_id: current_user.id)&.area_role %>
        <% next unless area_role %>
        <% area_permitted = DEFAULT_AREA_ACTIONS.select { |action| area_role[action] } %>
        <% area_denied = DEFAULT_AREA_ACTIONS.reject { |action| area_role[action] } %>
        <input type="radio" name="perm_tabs" role="tab" class="tab min-h-11" aria-label="<%= area.name %>">
        <div role="tabpanel" class="tab-content space-y-4 py-4">
          <% render_permission_list.call(t('pages.users.show.what_can_i_do'), area_permitted, 'text-success') %>
          <% render_permission_list.call(t('pages.users.show.what_i_cant_do'), area_denied, 'text-error') %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% render_permission_list.call(t('pages.users.show.what_can_i_do'), permitted_actions, 'text-success') %>
      <% render_permission_list.call(t('pages.users.show.what_i_cant_do'), denied_actions, 'text-error') %>
    </div>
  <% end %>
<% end %>
