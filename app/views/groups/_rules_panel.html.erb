<dialog id="rules_modal"
        class="modal"
        aria-labelledby="rules-modal-title"
        data-controller="modal"
        data-modal-open-on-connect-value="false"
        data-modal-remove-on-close-value="false">
  <div class="modal-box max-h-[80vh] max-w-2xl overflow-y-auto border-2 border-base-content/20">
    <button type="button"
            class="btn btn-ghost btn-circle btn-sm absolute right-2 top-2"
            aria-label="<%= t('buttons.close', default: 'Close') %>"
            data-action="click->modal#close">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
    <h2 id="rules-modal-title" class="mb-4 pr-10 text-xl font-extrabold"><%= t('pages.groups.show.rules_button') %></h2>
    <% if @group.rule_book&.body&.present? %>
      <div class="prose max-w-none"><%= @group.rule_book %></div>
    <% else %>
      <div class="prose max-w-none">
        <%= t('pages.groups.show.rule_book_html') %>
        <h3><%= t('pages.groups.show.participation_rules', default: 'Participation') %></h3>
        <p>
          <% if @group.request_by_vote? %>
            <%= t('pages.groups.show.request_by_vote_rules') %>
          <% elsif @group.request_by_portavoce? %>
            <%= t('pages.groups.show.request_by_spokesman_rules') %>
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop" data-action="click->modal#backdropClose">
    <button aria-label="<%= t('buttons.close', default: 'Close') %>"><%= t('buttons.close', default: 'Close') %></button>
  </form>
</dialog>
