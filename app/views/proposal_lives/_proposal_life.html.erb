<article>
  <h3 class="text-lg font-bold"><%= t('pages.proposal_histories.life_cycle_number', life: @life.seq) %></h3>
  <dl class="mt-4 grid gap-3 sm:grid-cols-2">
    <div class="bg-base-200 p-3"><dt class="text-xs text-base-content/60"><%= t('pages.proposal_histories.end_date') %></dt><dd class="font-semibold"><%= l @life.created_at %></dd></div>
    <div class="bg-base-200 p-3"><dt class="text-xs text-base-content/60"><%= t('pages.proposal_histories.score_reached') %></dt><dd class="font-semibold"><%= @life.rank %></dd></div>
    <div class="bg-base-200 p-3"><dt class="text-xs text-base-content/60"><%= t('pages.proposal_histories.evaluation_reached') %></dt><dd class="font-semibold"><%= @life.valutations %></dd></div>
    <div class="bg-base-200 p-3"><dt class="text-xs text-base-content/60"><%= t('pages.proposal_histories.quorum_used') %></dt><dd class="font-semibold"><%= @life.quorum&.explanation || t('models.quorum.help_content.not_specified') %></dd></div>
  </dl>
  <section class="mt-4" aria-labelledby="life-editors-title">
    <h4 id="life-editors-title" class="font-bold"><%= t('pages.proposal_histories.editors_in_life_cycle') %></h4>
    <div class="mt-2 flex flex-wrap gap-2"><% @life.users.each do |user| %><%= user_tag(user) %><% end %></div>
  </section>
</article>
